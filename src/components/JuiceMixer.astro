---
// src/components/JuiceMixer.astro
// Bundle options and available flavors for Helthe Juice
const bundles = [
  { size: 6, maxFlavors: 2, label: "6 Pack" },
  { size: 15, maxFlavors: 4, label: "15 Pack (Waiting List)" },
  { size: 24, maxFlavors: 5, label: "24 Pack (Family Size)" }
];

const flavors = [
  { id: "watermelon-mint", name: "Watermelon Mint", color: "bg-emerald-500" },
  { id: "pure-watermelon", name: "Pure Watermelon", color: "bg-rose-500" },
  { id: "pineapple-ginger", name: "Pineapple Ginger", color: "bg-amber-500" },
  { id: "citrus-twist", name: "Citrus Twist", color: "bg-orange-500" },
  { id: "hibiscus-berry", name: "Hibiscus Berry", color: "bg-purple-500" }
];
---




<div class="container">
    <div class="py-40">
        <div class="max-w-xl mx-auto bg-white p-6 rounded-2xl shadow-sm border border-gray-100 ">
          <h2 class="text-xl font-bold text-gray-900 mb-2">Build Your Juice Box</h2>
          <p class="text-sm text-gray-500 mb-6">Select your bundle size and mix your favorite flavors.</p>
        
          <!-- Step 1: Choose Bundle Size -->
          <div class="mb-6">
            <label class="block text-xs font-semibold uppercase tracking-wider text-gray-600 mb-2">1. Choose Bundle Size</label>
            <div class="grid grid-cols-3 gap-3">
              {bundles.map((bundle, index) => (
                <button
                  type="button"
                  class="bundle-btn px-4 py-3 rounded-xl border text-center transition-all cursor-pointer font-medium text-sm"
                  data-size={bundle.size}
                  data-max-flavors={bundle.maxFlavors}
                >
                  <div class="text-lg font-bold text-gray-900">{bundle.size} Pcs</div>
                  <div class="text-xs text-gray-500">Max {bundle.maxFlavors} flavors</div>
                </button>
              ))}
            </div>
          </div>
        
          <!-- Step 2: Flavor Allocator -->
          <div id="flavor-section" class="hidden opacity-0 transition-opacity duration-300">
            <div class="flex justify-between items-center mb-3">
              <label class="block text-xs font-semibold uppercase tracking-wider text-gray-600">2. Mix Flavors</label>
              <div class="text-xs font-medium text-gray-700">
                Bottles allocated: <span id="allocated-count" class="font-bold text-emerald-600">0</span> / <span id="target-count" class="font-bold">15</span>
              </div>
            </div>
        
            <!-- Active limits info -->
            <div class="bg-gray-50 p-3 rounded-lg text-xs text-gray-600 mb-4 flex justify-between items-center">
              <span>Flavor varieties used: <strong id="used-flavors">0</strong> of <strong id="max-flavors-allowed">4</strong> max</span>
              <span id="error-msg" class="text-rose-500 font-medium hidden">Max flavor limit reached!</span>
            </div>
        
            <!-- Flavor rows -->
            <div class="space-y-3 mb-6">
              {flavors.map((flavor) => (
                <div class="flavor-row flex items-center justify-between p-3 rounded-xl border border-gray-100 bg-white" data-flavor-id={flavor.id}>
                  <div class="flex items-center space-x-3">
                    <span class={`w-3 h-3 rounded-full ${flavor.color}`}></span>
                    <span class="text-sm font-medium text-gray-800">{flavor.name}</span>
                  </div>
                  <div class="flex items-center space-x-3">
                    <button type="button" class="decrease-btn w-8 h-8 rounded-lg bg-gray-100 text-gray-600 font-bold hover:bg-gray-200 flex items-center justify-center">-</button>
                    <span class="flavor-qty w-6 text-center font-bold text-sm text-gray-900">0</span>
                    <button type="button" class="increase-btn w-8 h-8 rounded-lg bg-gray-100 text-gray-600 font-bold hover:bg-gray-200 flex items-center justify-center">+</button>
                  </div>
                </div>
              ))}
            </div>
        
            <!-- Submit / Checkout Action -->
            <button id="proceed-btn" type="button" class="w-full bg-emerald-600 text-white font-medium py-3 rounded-xl hover:bg-emerald-700 transition-colors disabled:opacity-55 disabled:cursor-not-allowed" disabled>
              Proceed to Delivery & Checkout
            </button>
          </div>
        </div>

        
    </div>
</div>

<!-- Checkout Modal -->
<div id="checkout-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden flex items-center justify-center p-4 z-50">
  <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-xl relative max-h-[90vh] overflow-y-auto">
    <button id="close-modal-btn" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-xl font-bold">&times;</button>
    
    <h3 class="text-xl font-bold text-gray-900 mb-1">Complete Your Order</h3>
    <p class="text-xs text-gray-500 mb-4">Enter your details to schedule delivery and pay via PayAngel.</p>

    <!-- Order Summary Card -->
    <div class="bg-gray-50 p-4 rounded-xl border border-gray-100 mb-5">
      <div class="flex justify-between text-sm font-semibold text-gray-800 mb-2">
        <span>Order Summary</span>
        <span id="summary-pack-size" class="text-emerald-600">15 Pack</span>
      </div>
      <ul id="summary-flavor-list" class="text-xs text-gray-600 space-y-1 pl-2 border-l-2 border-emerald-500">
        <!-- Selected flavors dynamically inserted here -->
      </ul>
    </div>

    <!-- Customer Details Form -->
    <form id="order-form" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-gray-700 mb-1">Full Name</label>
        <input type="text" id="customer-name" required placeholder="e.g. Ama Mensah" class="w-full px-3 py-2 border rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-700 mb-1">WhatsApp / Phone Number (for MoMo & Alerts)</label>
        <input type="tel" id="customer-phone" required placeholder="0241234567" class="w-full px-3 py-2 border rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-700 mb-1">Delivery Address / Landmark</label>
        <input type="text" id="customer-address" required placeholder="e.g. East Legon, near ANC Mall" class="w-full px-3 py-2 border rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-700 mb-1">Preferred Delivery Date</label>
        <input type="date" id="delivery-date" required class="w-full px-3 py-2 border rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
      </div>

      <button type="submit" id="pay-angel-btn" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 rounded-xl transition-all shadow-md flex justify-center items-center gap-2 mt-4">
        <span>Pay with PayAngel (MoMo / Card)</span>
      </button>
    </form>
  </div>
</div>

















<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Elements
    const bundleBtns = document.querySelectorAll('.bundle-btn');
    const flavorSection = document.getElementById('flavor-section');
    const allocatedCountEl = document.getElementById('allocated-count');
    const targetCountEl = document.getElementById('target-count');
    const usedFlavorsEl = document.getElementById('used-flavors');
    const maxFlavorsAllowedEl = document.getElementById('max-flavors-allowed');
    const errorMsgEl = document.getElementById('error-msg');
    const proceedBtn = document.getElementById('proceed-btn');
    const flavorRows = document.querySelectorAll('.flavor-row');

    // Modal Elements
    const modal = document.getElementById('checkout-modal');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const summaryPackSize = document.getElementById('summary-pack-size');
    const summaryFlavorList = document.getElementById('summary-flavor-list');
    const orderForm = document.getElementById('order-form');

    let currentTargetSize = 15;
    let maxFlavorsAllowed = 4;
    let allocations = {};

    // Auto-select 15-pack on page load
    if (bundleBtns.length > 1) {
      selectBundle(bundleBtns[1]);
    } else if (bundleBtns.length > 0) {
      selectBundle(bundleBtns[0]);
    }

    // Bundle Selection
    bundleBtns.forEach(btn => {
      btn.addEventListener('click', () => selectBundle(btn));
    });

    function selectBundle(btn) {
      bundleBtns.forEach(b => b.classList.remove('border-emerald-600', 'bg-emerald-50/50', 'ring-2', 'ring-emerald-600'));
      btn.classList.add('border-emerald-600', 'bg-emerald-50/50', 'ring-2', 'ring-emerald-600');

      currentTargetSize = parseInt(btn.dataset.size, 10);
      maxFlavorsAllowed = parseInt(btn.dataset.maxFlavors, 10);

      if (targetCountEl) targetCountEl.textContent = currentTargetSize;
      if (maxFlavorsAllowedEl) maxFlavorsAllowedEl.textContent = maxFlavorsAllowed;

      // Reset allocations
      allocations = {};
      flavorRows.forEach(row => {
        const qtyEl = row.querySelector('.flavor-qty');
        if (qtyEl) qtyEl.textContent = '0';
      });

      if (flavorSection) {
        flavorSection.classList.remove('hidden');
        setTimeout(() => flavorSection.classList.remove('opacity-0'), 10);
      }
      updateUI();
    }

    // Plus / Minus Button Listeners
    flavorRows.forEach(row => {
      const flavorId = row.dataset.flavorId;
      const incBtn = row.querySelector('.increase-btn');
      const decBtn = row.querySelector('.decrease-btn');
      const qtyEl = row.querySelector('.flavor-qty');

      if (incBtn) {
        incBtn.addEventListener('click', () => {
          const currentQty = allocations[flavorId] || 0;
          const activeFlavorsCount = getActiveFlavorsCount();
          const totalAllocated = getTotalAllocated();

          if (currentQty === 0 && activeFlavorsCount >= maxFlavorsAllowed) {
            showError(`Maximum ${maxFlavorsAllowed} flavor varieties allowed for this pack size.`);
            return;
          }

          if (totalAllocated >= currentTargetSize) {
            showError(`You have reached the limit of ${currentTargetSize} bottles.`);
            return;
          }

          allocations[flavorId] = currentQty + 1;
          if (qtyEl) qtyEl.textContent = allocations[flavorId];
          updateUI();
        });
      }

      if (decBtn) {
        decBtn.addEventListener('click', () => {
          const currentQty = allocations[flavorId] || 0;
          if (currentQty > 0) {
            allocations[flavorId] = currentQty - 1;
            if (allocations[flavorId] === 0) {
              delete allocations[flavorId];
            }
            if (qtyEl) qtyEl.textContent = allocations[flavorId] || 0;
            updateUI();
          }
        });
      }
    });

    function getTotalAllocated() {
      return Object.values(allocations).reduce((sum, qty) => sum + qty, 0);
    }

    function getActiveFlavorsCount() {
      return Object.keys(allocations).filter(key => allocations[key] > 0).length;
    }

    function updateUI() {
      const total = getTotalAllocated();
      const activeFlavors = getActiveFlavorsCount();

      if (allocatedCountEl) allocatedCountEl.textContent = total;
      if (usedFlavorsEl) usedFlavorsEl.textContent = activeFlavors;

      if (proceedBtn) {
        if (total === currentTargetSize) {
          proceedBtn.removeAttribute('disabled');
          proceedBtn.classList.remove('opacity-55', 'cursor-not-allowed');
          if (errorMsgEl) errorMsgEl.classList.add('hidden');
        } else {
          proceedBtn.setAttribute('disabled', 'true');
          proceedBtn.classList.add('opacity-55', 'cursor-not-allowed');
        }
      }
    }

    function showError(msg) {
      if (errorMsgEl) {
        errorMsgEl.textContent = msg;
        errorMsgEl.classList.remove('hidden');
        setTimeout(() => errorMsgEl.classList.add('hidden'), 3000);
      }
    }

    // Modal Trigger - Open Modal on "Proceed to Delivery & Checkout"
    if (proceedBtn) {
      proceedBtn.addEventListener('click', (e) => {
        e.preventDefault();
        
        if (summaryPackSize) summaryPackSize.textContent = `${currentTargetSize} Pack`;
        
        if (summaryFlavorList) {
          summaryFlavorList.innerHTML = '';
          Object.entries(allocations).forEach(([flavorId, qty]) => {
            if (qty > 0) {
              const li = document.createElement('li');
              const readableName = flavorId.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
              li.textContent = `${qty}x ${readableName}`;
              summaryFlavorList.appendChild(li);
            }
          });
        }

        if (modal) {
          modal.classList.remove('hidden');
        } else {
          console.error("checkout-modal element not found in DOM");
        }
      });
    }

    // Close Modal Button
    if (closeModalBtn) {
      closeModalBtn.addEventListener('click', () => {
        if (modal) modal.classList.add('hidden');
      });
    }

    // Close Modal when clicking outside the box
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.add('hidden');
        }
      });
    }

    // Form Submit Handler
    if (orderForm) {
      orderForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const payload = {
          customerName: (document.getElementById('customer-name') as HTMLInputElement)?.value,
          customerPhone: (document.getElementById('customer-phone') as HTMLInputElement)?.value,
          address: (document.getElementById('customer-address') as HTMLInputElement)?.value,
          deliveryDate: (document.getElementById('delivery-date') as HTMLInputElement)?.value,
          bundleSize: currentTargetSize,
          flavors: allocations
        };

        console.log('Order payload ready:', payload);
        const payBtn = document.getElementById('pay-angel-btn');
if (payBtn) payBtn.innerText = 'Processing...';

try {
  const response = await fetch('/api/create-payment', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  });

  const result = await response.json();

  if (result.success) {
    // In live mode, this redirects to PayAngel MoMo/Card checkout page
    // In mock mode, it redirects to our test success page
    window.location.href = result.redirectUrl;
  } else {
    alert('Something went wrong. Please try again.');
    if (payBtn) payBtn.innerText = 'Pay with PayAngel (MoMo / Card)';
  }
} catch (err) {
  console.error(err);
  alert('Error connecting to payment server.');
  if (payBtn) payBtn.innerText = 'Pay with PayAngel (MoMo / Card)';
}
      });
    }
  });
</script>