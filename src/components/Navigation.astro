---
// src/components/Header.astro
import { Image } from "astro:assets";
import Logo from "/src/assets/logo-white.png";
---

<!-- navOverlay -->
<div id="nav-overlay" class="nav-overlay"></div>

<!-- nav-bar -->
<nav class="nav-bar">
    <div class="container wrapper">
        <div class="flex flex-wrap items-center justify-between mx-auto p-4">
            <!-- logo -->
            <a href="/" class="flex items-center space-x-3 rtl:space-x-reverse">
                <Image src={Logo} alt="Helthe Juice Logo" class="logo w-14">
            </a>
    
            <!-- Mobile Menu Toggle Button -->
            <div id="nav-btn" class="nav-btn">
                <div class="lines"></div>
                <div class="lines"></div>
                <div class="lines"></div>
            </div>
    
            <!-- Nav Menu -->
            <div class="flex items-center justify-center gap-3 nav-list" id="nav-list">
                <ul class="text-center pb-8 md:pb-0 md:pr-4 md:flex" id="navbar-sticky">
                    <li class="nav-item">
                        <a href="/juices" class="nav-link">Our Juices</a>
                    </li>
                    <li class="nav-item">
                        <a href="/order" class="nav-link">Build a Box</a>
                    </li>
                </ul>

                <!-- Dynamic Account / Sign In Link -->
                <a href="/login" id="nav-auth-link" class="nav-link text-xs font-bold text-stone-300 hover:text-white transition-colors hidden md:inline-block">
                    Sign In
                </a>

                <a href="/order" class="btn btn-yellow px-4 py-2 bg-amber-500 hover:bg-amber-600 text-stone-950 font-extrabold rounded-xl text-xs transition-all shadow-sm">Order Now</a>
            </div>
        </div>
    </div>
</nav>

<!-- Auth State & Mobile Menu Script -->
<script>
    import { auth } from '../lib/firebase';
    import { onAuthStateChanged } from 'firebase/auth';

    const navBtn = document.getElementById('nav-btn');
    const navList = document.getElementById('nav-list');
    const navOverlay = document.getElementById('nav-overlay');
    const authLink = document.getElementById('nav-auth-link') as HTMLAnchorElement;

    function toggleMenu() {
        navBtn?.classList.toggle('close');
        navList?.classList.toggle('show');
        navOverlay?.classList.toggle('show');
    }

    navBtn?.addEventListener('click', toggleMenu);
    navOverlay?.addEventListener('click', toggleMenu);

    // Close menu when clicking nav links on mobile
    document.querySelectorAll('.nav-link').forEach(link => {
        link.addEventListener('click', () => {
            if (navList?.classList.contains('show')) {
                toggleMenu();
            }
        });
    });

    // Dynamically update account link based on Firebase Auth state
    onAuthStateChanged(auth, (user) => {
        if (authLink) {
            if (user) {
                authLink.href = '/dashboard';
                authLink.textContent = 'My Account';
            } else {
                authLink.href = '/login';
                authLink.textContent = 'Sign In';
            }
        }
    });
</script>

<style lang="scss">
    // ============= Nav-Overlay ================
    .nav-overlay {
        width: 100%;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.4);
        position: fixed;
        z-index: 10;
        top: 0;
        left: 0;
        bottom: 0;
        right: 0;
        pointer-events: none;
        opacity: 0;
        backdrop-filter: blur(10px);
        transition: opacity 0.3s ease;

        &.show {
            opacity: 1;
            pointer-events: initial;
        }
    }

    .nav-bar {
        background: linear-gradient(to right bottom, rgba(52, 52, 52, 0.318), rgba(60, 60, 60, 0.306));
        width: 100%;
        position: relative;

        // ============= Nav Button  =================
        .nav-btn {
            position: absolute;
            right: 35px;
            z-index: 21;
            cursor: pointer;

            .lines {
                width: 1.7rem;
                height: .15rem;
                background-color: var(--clr-white, #ffffff);
                transition: .4s;

                &:not(:last-child) {
                    margin-bottom: .5rem;
                }
            }
            &.close {
                .lines {
                    &:nth-child(1) {
                        transform: rotate(-45deg) translate(-6px, 6px);
                    }
                    &:nth-child(2) {
                        opacity: 0;
                    }
                    &:nth-child(3) {
                        transform: rotate(45deg) translate(-6px, -6px);
                    }
                }
            }
        }
    }

    // desktops
    @media screen and (min-width: 768px) {
        .nav-bar {
            width: 100%;
            max-width: 900px;
            display: flex;
            padding: 0 2rem;
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, .2);
            border-radius: 3rem;
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 10;
            transition: .4s;
        }

        .nav-btn {
            display: none;
        }

        .nav-list {
            display: flex;

            .nav-item {
                &:not(:last-child) {
                    .nav-link {
                        border-right: 1px solid rgba(255, 255, 255, .1);
                    }
                }
            }

            .nav-link {
                display: inline-block;
                color: var(--clr-white, #ffffff);
                padding: 0rem 1rem;
                font-size: .9rem;
                font-weight: bold;

                &:hover {
                    color: #34d399;
                }
            }
        }
    }

    // Mobile devices
    @media screen and (max-width: 767px) {
        .nav-bar {
            width: 95vw;
            border-radius: 3rem;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, .1);
            position: fixed;
            top: 1rem;
            left: 50%;
            transform: translateX(-50%);
            z-index: 20;

            .nav-list {
                width: 100%;
                transition: transform 0.4s ease;
                background-color: #111827;
                position: fixed;
                top: 0;
                left: 0;
                z-index: 15;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                min-height: 60vh;
                transform: translate3d(0, -110%, 0);
                padding-top: 2rem;
                border-bottom-left-radius: 2rem;
                border-bottom-right-radius: 2rem;
                
                &.show {
                    transform: translate3d(0, 0%, 0);
                }

                .nav-item {
                    &:not(:last-child) {
                        margin-bottom: 1rem;
                    }
                }

                .nav-link {
                    display: inline-block;
                    padding: .5rem 2rem;
                    font-size: 1.2rem;
                    border-radius: .5rem;
                    color: #ffffff;

                    &:hover {
                        color: #34d399;
                    }
                }
            }
        }
    }
</style>