---
import { Image } from "astro:assets";
import Logo from "/src/assets/logo-white.png"
import LogoLight from "/src/assets/logo-light.png"
---




<!-- navOverlay -->
<div class="nav-overlay"></div>



<!-- nav-bar -->
<nav class="nav-bar">
    <div class="container wrapper">
        <div class="flex flex-wrap items-center justify-between mx-auto p-4">
            <!-- logo -->
            <a href="/" class="flex items-center space-x-3 rtl:space-x-reverse">
                <Image src={Logo} alt="Winnard Bansah Logo" class="logo w-15">
            </a>
    
            <!-- Buttons -->
            <!-- Menu Button -->
            <div class="nav-btn">
                <div class="lines"></div>
                <div class="lines"></div>
                <div class="lines"></div>
            </div>
    
    
            <!-- Nav Menu -->
            <div class="flex items-center justify-center nav-list">
                <ul class="text-center pb-8 md:pb-0 md:pr-8 md:flex" id="navbar-sticky">
                    <li class="nav-item">
                        <a href="/watermelon" class="nav-link" aria-current="page">Pre-Order Watermelon</a>
                    </li>
                    <li class="nav-item">
                        <a href="/juices" class="nav-link">Our Juices</a>
                    </li>
                    
                    <li class="nav-item">
                        <a href="/contact" class="nav-link">Contact</a>
                    </li>
                </ul>
                <a href="/order" class="btn btn-yellow">Order Now</a>
            </div>
        </div>
    </div>
  </nav>

  















<style lang="scss">



    .btn {
        // padding: .5rem 1rem;
    }
    
    
    // ============= Nav-Overlay ================
    .nav-overlay {
        width: 100%;
        height: 100vh;
        background-color: rgba(181, 176, 151, 0.397);
        position: fixed;
        z-index: 10;
        top: 0;
        left: 0;
        bottom: 0;
        right: 0;
        pointer-events: none;
        opacity: 0;
        backdrop-filter: blur(10px);

        &.show {
            opacity: 1;
            pointer-events: initial;

        }
    }


.nav-bar {
    background: linear-gradient( to right bottom, rgba(52, 52, 52, 0.318), rgba(60, 60, 60, 0.306));
    // background-color: red;
    width: 100%;
    position: relative;











    // ============= Nav Button  =================
    .nav-btn {
        position: absolute;
        // top: 20px;
        right: 35px;
        z-index: 21;
        cursor: pointer;

        .lines {
            width: 1.7rem;
            height: .1rem;
            background-color: var(--clr-white);
            // background-color: green;
            transition: .4s;

            &:not(:last-child) {
                margin-bottom: .5rem;
            }
        }
        &.close {
            
            
            .lines {
    
                &:nth-child(1) {
                    transform: rotate(-45deg) translate(-8px, 6px);
                }
                &:nth-child(2) {
                    opacity: 0;
                }
                &:nth-child(3) {
                    transform: rotate(45deg) translate(-7px, -7px);
                }
            }
        }
    }

}






// desktops
@media screen and (min-width: 768px) {

    .nav-bar {
        // background-color: var(--clr-black);
        width: 100%;
        // max-width: 900px;
        display: flex;
        padding: 0 3rem;
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, .2);
        position: fixed;
        position: -webkit-sticky;
        top: s0px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        transition: .4s;
        // display: none;
        // position: fixed;
    }

    .nav-btn {
        display: none;
    }

    // ====================== Nav List ================
    .nav-list {
        display: flex;
        

        .nav-item {

            &:not(:last-child) {

                .nav-link {
                    border-right: 1px solid rgba(255, 255, 255, .1);
                }
            }
        }

        .nav-link {
            display: inline-block;
            color: var(--clr-white);
            padding: 0rem .5rem;
            font-size: .9rem;
            font-weight: bold;

            &:hover,
            &:focus {
                color: var(--clr-white);
            }
        }
    }

    
}






// Mobile devices
@media screen and (max-width: 767px) {

    .btn {
        // display: none;
    }

    .nav-bar {
        width: 95vw;
        border-radius: 3rem;
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(255, 255, 255, .1);
        position: fixed;
        top: 1rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 20;

        .nav-list {
            width: 100%;
            transition: .4s;
            background-color: var(--clr-black);
            position: fixed;
            top: 0;
            left: 0;
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 50vh;
            transform: translate3d(0, -110%, 0);
            
            &.show {
                transform: translate3d(0, 00%, 0);
                border-radius: 3rem;
            }

            .nav-item {

                &:not(:last-child) {
                    margin-bottom: .3rem;
                }
            }

            .nav-link {
                display: inline-block;
                padding: .5rem 2rem;
                font-size: 1.2rem;
                border-radius: .5rem;
                border: 1px solid transparent;
                color: var(--clr-white);

                &:hover {
                    border: 1px solid var(--clr-orange);
                    color: var(--clr-yellow);
                }
            }
        }
    }
}
</style>
