---
// src/pages/admin/index.astro
export const prerender = false;
import '../../styles/global.css';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard | Helthe Juice</title>
  </head>
  <body class="bg-stone-50 font-sans min-h-screen text-stone-900 selection:bg-emerald-500 selection:text-white pb-20">
    
    <!-- Login Section -->
    <section id="login" class="max-w-md mx-auto mt-24 p-8 bg-white rounded-3xl shadow-xl border border-stone-200/80 space-y-6">
      <div class="text-center space-y-1.5">
        <span class="px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full text-[10px] font-black uppercase tracking-wider">Restricted Access</span>
        <h1 class="text-2xl font-black text-stone-950 tracking-tight pt-2">Admin Portal</h1>
        <p class="text-xs text-stone-500 font-medium">Sign in to manage flavors and weekly production batches</p>
      </div>
      
      <form id="login-form" class="space-y-4">
        <div>
          <label class="block text-[11px] font-black text-stone-700 uppercase tracking-wider mb-1.5">Email Address</label>
          <input name="email" type="email" placeholder="helthegh@gmail.com" required class="w-full px-4 py-3 bg-stone-50 border border-stone-200 rounded-2xl text-xs font-bold text-stone-900 focus:outline-none focus:border-emerald-600 focus:bg-white transition-all" />
        </div>
        <div>
          <label class="block text-[11px] font-black text-stone-700 uppercase tracking-wider mb-1.5">Password</label>
          <input name="password" type="password" placeholder="••••••••" required class="w-full px-4 py-3 bg-stone-50 border border-stone-200 rounded-2xl text-xs font-bold text-stone-900 focus:outline-none focus:border-emerald-600 focus:bg-white transition-all" />
        </div>
        <button type="submit" class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-black rounded-2xl text-xs transition-all shadow-lg shadow-emerald-600/20">
          Sign In to Dashboard
        </button>
      </form>
      <p id="login-error" class="text-xs text-rose-600 text-center font-bold"></p>
    </section>

    <!-- Admin Panel Content (Hidden until authenticated) -->
    <main id="panel" hidden class="max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-8">
      
      <!-- Top Bar -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-6 rounded-3xl border border-stone-200/80 shadow-sm">
        <div class="space-y-0.5">
          <div class="flex items-center gap-2">
            <h1 class="text-lg sm:text-xl font-black tracking-tight text-stone-950">Helthe Juice Management</h1>
            <span class="px-2.5 py-0.5 bg-emerald-100 text-emerald-800 rounded-full text-[10px] font-black uppercase tracking-wider">Live</span>
          </div>
          <p class="text-xs text-stone-500 font-medium">Make-to-Order Pre-Order Dashboard & Batch Production System</p>
        </div>
        <button id="logout" class="w-full sm:w-auto px-4 py-2.5 bg-stone-100 hover:bg-stone-200 text-stone-700 rounded-2xl text-xs font-black transition-all">
          Log Out
        </button>
      </div>

      <!-- Batch Production Aggregator Card -->
      <div class="bg-gradient-to-br from-amber-50/80 via-orange-50/50 to-amber-100/40 border border-amber-200/70 p-6 sm:p-8 rounded-3xl shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div class="space-y-1">
            <span class="px-3 py-1 bg-amber-600 text-white rounded-full text-[10px] font-black uppercase tracking-wider">Weekly Batching</span>
            <h2 class="text-base sm:text-lg font-black text-stone-950 mt-1">Upcoming Juicing Production List</h2>
            <p class="text-xs text-stone-600 font-medium">Total bottles required based on all active customer pre-orders:</p>
          </div>
        </div>
        <div id="batch-prep-list" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 pt-2">
          <p class="text-xs text-stone-400 font-medium col-span-full">Loading batch requirements...</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Left: Product / Flavor Form -->
        <div class="bg-white p-6 sm:p-8 rounded-3xl border border-stone-200/80 shadow-sm space-y-5 h-fit">
          <div class="flex items-center justify-between border-b border-stone-100 pb-4">
            <h2 id="form-title" class="text-sm font-black text-stone-950 uppercase tracking-wider">Add New Flavor</h2>
            <button type="button" id="cancel-edit" hidden class="text-xs text-rose-600 font-bold hover:underline">Cancel Edit</button>
          </div>

          <form id="product-form" class="space-y-4">
            <input type="hidden" name="id" />
            
            <div>
              <label class="block text-[11px] font-black text-stone-700 uppercase tracking-wider mb-1.5">Juice Name</label>
              <input name="name" placeholder="e.g. Pineapple Ginger" required class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-emerald-600 focus:bg-white transition-all" />
            </div>

            <div>
              <label class="block text-[11px] font-black text-stone-700 uppercase tracking-wider mb-1.5">Fruits (comma separated)</label>
              <input name="fruits" placeholder="pineapple, ginger" required class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-emerald-600 focus:bg-white transition-all" />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-[11px] font-black text-stone-700 uppercase tracking-wider mb-1.5">Price (GHS)</label>
                <input name="price" type="number" step="0.50" min="0" value="15.00" required class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-emerald-600 focus:bg-white transition-all" />
              </div>
              <div>
                <label class="block text-[11px] font-black text-stone-700 uppercase tracking-wider mb-1.5">Volume</label>
                <input name="volume" value="350ml" required class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-emerald-600 focus:bg-white transition-all" />
              </div>
            </div>

            <div>
              <label class="block text-[11px] font-black text-stone-700 uppercase tracking-wider mb-1.5">Product Image</label>
              <input name="image" type="file" accept="image/*" class="w-full text-xs text-stone-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-black file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 transition-all cursor-pointer" />
            </div>

            <div class="flex items-center gap-2.5 pt-2">
              <input name="active" type="checkbox" id="active" checked class="w-4 h-4 text-emerald-600 rounded border-stone-300 focus:ring-emerald-500" />
              <label for="active" class="text-xs font-bold text-stone-700">Visible on live menu</label>
            </div>

            <button type="submit" class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-black rounded-2xl text-xs transition-all shadow-md shadow-emerald-600/20">
              Save Flavor
            </button>
          </form>
        </div>

        <!-- Right: Menu Flavors & Orders Management -->
        <div class="lg:col-span-2 space-y-8">
          
          <!-- Menu Flavors Catalog List -->
          <div class="bg-white p-6 sm:p-8 rounded-3xl border border-stone-200/80 shadow-sm space-y-5">
            <div class="flex items-center justify-between border-b border-stone-100 pb-4">
              <h2 class="text-sm font-black text-stone-950 uppercase tracking-wider">Active Menu Flavors (<span id="product-count" class="text-emerald-600">0</span>)</h2>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs min-w-[500px]">
                <thead>
                  <tr class="border-b border-stone-100 text-stone-400 uppercase font-black tracking-wider text-[10px]">
                    <th class="pb-3">Flavor</th>
                    <th class="pb-3">Price</th>
                    <th class="pb-3">Status</th>
                    <th class="pb-3 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody id="product-list" class="divide-y divide-stone-100/80">
                  <!-- Injected via client script -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- Orders Ledger List -->
          <div class="bg-white p-6 sm:p-8 rounded-3xl border border-stone-200/80 shadow-sm space-y-5">
            <div class="flex items-center justify-between border-b border-stone-100 pb-4">
              <h2 class="text-sm font-black text-stone-950 uppercase tracking-wider">Customer Pre-Orders Ledger</h2>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs min-w-[650px]">
                <thead>
                  <tr class="border-b border-stone-100 text-stone-400 uppercase font-black tracking-wider text-[10px]">
                    <th class="pb-3">Order ID / Date</th>
                    <th class="pb-3">Customer</th>
                    <th class="pb-3">Items</th>
                    <th class="pb-3">Total</th>
                    <th class="pb-3">Status</th>
                    <th class="pb-3 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody id="order-list" class="divide-y divide-stone-100/80">
                  <!-- Injected via client script -->
                </tbody>
              </table>
            </div>
          </div>

        </div>

      </div>
    </main>

    <!-- Admin Client Script Logic -->
    <script>
      import { auth, db, storage } from '../../lib/firebase';
      import { signInWithEmailAndPassword, signOut, onAuthStateChanged } from 'firebase/auth';
      import {
        collection, doc, addDoc, updateDoc, onSnapshot, query, orderBy, limit, serverTimestamp, where,
      } from 'firebase/firestore';
      import { ref, uploadBytes, getDownloadURL } from 'firebase/storage';

      const $ = (id: string) => document.getElementById(id)!;
      const form = $('product-form') as HTMLFormElement;
      let products: Record<string, any> = {};
      let unsubscribers: Array<() => void> = [];

      // Login handler
      $('login-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = new FormData(e.target as HTMLFormElement);
        try {
          $('login-error').textContent = '';
          await signInWithEmailAndPassword(auth, String(f.get('email')), String(f.get('password')));
        } catch (err: any) {
          $('login-error').textContent = 'Invalid credentials or unauthorized.';
        }
      });

      $('logout').addEventListener('click', () => signOut(auth));

      // Auth state listener with custom claim & direct admin email check
      onAuthStateChanged(auth, async (user) => {
        unsubscribers.forEach((u) => u());
        unsubscribers = [];
        
        if (!user) {
          $('login').hidden = false;
          $('panel').hidden = true;
          return;
        }

        const token = await user.getIdTokenResult(true);
        if (!token.claims.admin && user.email !== 'helthegh@gmail.com') {
          $('login-error').textContent = 'Access denied: Account lacks administrator permissions.';
          await signOut(auth);
          return;
        }

        $('login').hidden = true;
        $('panel').hidden = false;
        listenToProducts();
        listenToOrders();
        listenToBatchSummary();
      });

      // Products real-time listener
      function listenToProducts() {
        const q = query(collection(db, 'products'), orderBy('createdAt', 'desc'));
        unsubscribers.push(onSnapshot(q, (snap) => {
          products = {};
          const list = $('product-list');
          list.innerHTML = '';
          $('product-count').textContent = String(snap.size);

          snap.forEach((d) => {
            const p = d.data();
            products[d.id] = p;
            const tr = document.createElement('tr');
            tr.className = 'hover:bg-stone-50/60 transition-colors';
            tr.innerHTML = `
              <td class="py-3.5 font-bold text-stone-900 flex items-center gap-3">
                ${p.imageUrl ? `<img src="${p.imageUrl}" class="w-9 h-9 rounded-xl object-cover border border-stone-200" />` : '<div class="w-9 h-9 rounded-xl bg-stone-100 flex items-center justify-center text-[10px] text-stone-400 font-bold">Juice</div>'}
                <span>${p.name}</span>
              </td>
              <td class="py-3.5 font-extrabold text-stone-900">GHS ${(p.price / 100).toFixed(2)}</td>
              <td class="py-3.5">
                <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wide ${p.active ? 'bg-emerald-50 text-emerald-800 border border-emerald-200/60' : 'bg-stone-100 text-stone-500'}">
                  ${p.active ? 'Active' : 'Hidden'}
                </span>
              </td>
              <td class="py-3.5 text-right">
                <button type="button" class="edit-btn px-3 py-1.5 bg-stone-100 hover:bg-stone-200 text-stone-700 rounded-xl font-black text-xs transition-all" data-id="${d.id}">Edit</button>
              </td>
            `;
            tr.querySelector('.edit-btn')!.addEventListener('click', () => startEdit(d.id));
            list.append(tr);
          });
        }));
      }

      // Batch Production Aggregator Listener
      function listenToBatchSummary() {
        const q = query(collection(db, 'orders'), where('status', 'in', ['paid', 'pending']));
        unsubscribers.push(onSnapshot(q, (snap) => {
          const batchTotals: Record<string, number> = {};
          snap.forEach(d => {
            const order = d.data();
            (order.items || []).forEach((item: any) => {
              batchTotals[item.name] = (batchTotals[item.name] || 0) + item.qty;
            });
          });

          const prepListEl = $('batch-prep-list');
          if (Object.keys(batchTotals).length === 0) {
            prepListEl.innerHTML = `<p class="col-span-full text-xs text-stone-500 font-medium py-2">No pending pre-orders for the upcoming batch right now.</p>`;
            return;
          }

          prepListEl.innerHTML = Object.entries(batchTotals).map(([name, qty]) => `
            <div class="bg-white/90 border border-amber-200/80 p-3.5 rounded-2xl flex flex-col justify-between shadow-xs space-y-2">
              <span class="font-bold text-stone-900 text-xs line-clamp-1">${name}</span>
              <span class="px-2.5 py-1 bg-amber-600 text-white rounded-xl font-black text-xs w-fit">${qty} bottles</span>
            </div>
          `).join('');
        }));
      }

      function startEdit(id: string) {
        const p = products[id];
        (form.elements.namedItem('id') as HTMLInputElement).value = id;
        (form.elements.namedItem('name') as HTMLInputElement).value = p.name;
        (form.elements.namedItem('fruits') as HTMLInputElement).value = (p.fruits || []).join(', ');
        (form.elements.namedItem('price') as HTMLInputElement).value = (p.price / 100).toFixed(2);
        (form.elements.namedItem('volume') as HTMLInputElement).value = p.volume || '350ml';
        (form.elements.namedItem('active') as HTMLInputElement).checked = p.active;
        $('form-title').textContent = `Edit ${p.name}`;
        $('cancel-edit').hidden = false;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function resetForm() {
        form.reset();
        (form.elements.namedItem('id') as HTMLInputElement).value = '';
        $('form-title').textContent = 'Add New Flavor';
        $('cancel-edit').hidden = true;
      }
      $('cancel-edit').addEventListener('click', resetForm);

      // Product Form submission handler
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        try {
          const f = new FormData(form);
          const id = String(f.get('id') || '');
          const data = {
            name: String(f.get('name')).trim(),
            fruits: String(f.get('fruits')).split(',').map(s => s.trim().toLowerCase()).filter(Boolean),
            price: Math.round(Number(f.get('price')) * 100),
            volume: String(f.get('volume')).trim() || '350ml',
            active: f.get('active') === 'on',
          };

          const file = f.get('image');
          if (file && (file as File).size > 0) {
            const imgRef = ref(storage, `products/${Date.now()}-${(file as File).name}`);
            await uploadBytes(imgRef, file as File);
            data.imageUrl = await getDownloadURL(imgRef);
          }

          if (id) {
            await updateDoc(doc(db, 'products', id), data);
          } else {
            await addDoc(collection(db, 'products'), { ...data, createdAt: serverTimestamp() });
          }
          resetForm();
          alert('Flavor saved successfully!');
        } catch (err) {
          console.error('Error saving flavor:', err);
          alert('Failed to save flavor. Check console for details.');
        }
      });

      // Orders real-time listener with WhatsApp confirmation builder
      function listenToOrders() {
        const q = query(collection(db, 'orders'), orderBy('createdAt', 'desc'), limit(50));
        unsubscribers.push(onSnapshot(q, (snap) => {
          const list = $('order-list');
          list.innerHTML = '';
          snap.forEach((d) => {
            const o = d.data();
            const tr = document.createElement('tr');
            const itemsSummary = (o.items || []).map((i: any) => `${i.qty}× ${i.name}`).join(', ');
            const dateStr = o.createdAt?.toDate ? o.createdAt.toDate().toLocaleDateString() : 'Just now';
            const orderIdShort = d.id.slice(-6).toUpperCase();
            const totalGhs = (o.total / 100).toFixed(2);

            // Clean customer phone number for WhatsApp link (removes spaces/symbols)
            const rawPhone = o.customer.phone || '';
            const cleanPhone = rawPhone.replace(/\D/g, '');
            
            // Pre-formatted WhatsApp confirmation message
            const waMessage = encodeURIComponent(
              `Hello ${o.customer.name}! 👋 Thank you for your Helthe Juice pre-order (#${orderIdShort}).\n\n` +
              `📦 *Items:* ${itemsSummary}\n` +
              `💰 *Total:* GHS ${totalGhs}\n` +
              `📍 *Delivery Area:* ${o.customer.location || 'Accra'}\n\n` +
              `We are confirming your order for our upcoming batch delivery. Let us know if you have any questions!`
            );
            const waUrl = cleanPhone ? `https://wa.me/${cleanPhone.startsWith('233') ? cleanPhone : '233' + cleanPhone.replace(/^0/, '')}?text=${waMessage}` : '#';

            tr.className = 'hover:bg-stone-50/60 transition-colors';
            tr.innerHTML = `
              <td class="py-3.5">
                <span class="font-black text-stone-900 block">#${orderIdShort}</span>
                <span class="text-[10px] text-stone-400 font-semibold">${dateStr}</span>
              </td>
              <td class="py-3.5">
                <span class="font-bold text-stone-900 block">${o.customer.name}</span>
                <span class="text-[10px] text-stone-500 font-medium">${o.customer.phone}</span>
              </td>
              <td class="py-3.5 text-stone-600 max-w-xs truncate font-medium">${itemsSummary}</td>
              <td class="py-3.5 font-black text-stone-900">GHS ${totalGhs}</td>
              <td class="py-3.5">
                <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wide ${
                  o.status === 'paid' ? 'bg-emerald-100 text-emerald-800' :
                  o.status === 'fulfilled' ? 'bg-blue-100 text-blue-800' : 'bg-amber-100 text-amber-800'
                }">
                  ${o.status}
                </span>
              </td>
              <td class="py-3.5 text-right space-x-2">
                <a href="${waUrl}" target="_blank" class="inline-flex items-center px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-black text-xs transition-all shadow-xs">
                  WhatsApp
                </a>
                ${o.status === 'paid' || o.status === 'pending' ? `<button class="fulfill-btn px-3 py-1.5 bg-stone-900 hover:bg-stone-800 text-white rounded-xl font-black text-xs transition-all shadow-xs" data-id="${d.id}">Fulfill</button>` : '<span class="text-stone-400 font-bold text-[10px]">Fulfilled</span>'}
              </td>
            `;
            const fulfillBtn = tr.querySelector('.fulfill-btn');
            if (fulfillBtn) {
              fulfillBtn.addEventListener('click', () => updateDoc(doc(db, 'orders', d.id), { status: 'fulfilled' }));
            }
            list.append(tr);
          });
        }));
      }
    </script>
  </body>
</html>