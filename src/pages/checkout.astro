---
// src/pages/checkout.astro
export const prerender = false;

import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Checkout & Secure Payment — Helthe Juice">
  <script src="https://js.paystack.co/v1/inline.js" is:inline></script>

  <div class="min-h-screen bg-[#fdfaf5] py-10 px-4 sm:px-6 pt-28 pb-40 font-sans">
    <div class="max-w-6xl mx-auto space-y-8">
      
      <!-- Page Header -->
      <div class="flex items-center justify-between border-b border-stone-200 pb-4">
        <div>
          <span class="text-[10px] font-black uppercase tracking-wider text-blue-900 bg-blue-100 px-3 py-1 rounded-full">Secure Checkout</span>
          <h1 class="text-2xl font-black text-stone-950 tracking-tight mt-1">Review Order & Complete Payment</h1>
          <p class="text-xs text-stone-500 font-medium">Verify your selection, delivery date, and pay securely via Paystack.</p>
        </div>
        <a href="/order" class="text-xs font-bold text-stone-600 hover:text-blue-800 transition-colors cursor-pointer">
          ← Edit Selections
        </a>
      </div>

      <!-- Two-Column Split Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- LEFT COLUMN: Order Summary -->
        <div class="lg:col-span-7 space-y-6">
          <div class="bg-white rounded-3xl border border-stone-200 shadow-xl p-6 sm:p-8 space-y-6">
            
            <div class="flex items-center justify-between border-b border-stone-100 pb-4">
              <h2 class="text-sm font-black text-stone-900 uppercase tracking-wider">Your Selection Summary</h2>
              <span id="summary-box-badge" class="px-3 py-1 bg-blue-100 text-blue-900 rounded-full text-[10px] font-black uppercase">One-Time Order</span>
            </div>

            <!-- Itemized List -->
            <ul id="summary-items-list" class="divide-y divide-stone-100 text-xs text-stone-700 font-bold space-y-3 pt-2">
              <!-- Injected via JavaScript -->
            </ul>

            <!-- Pricing Calculation Box -->
            <div class="bg-stone-50 rounded-2xl p-4 space-y-2 border border-stone-200/60">
              <div class="flex justify-between text-xs text-stone-500 font-medium">
                <span>Order Subtotal</span>
                <span id="summary-single-box-cost" class="font-bold text-stone-900">GHS 0.00</span>
              </div>
              <div class="flex justify-between text-xs text-stone-500 font-medium">
                <span>Payment Type</span>
                <span class="font-bold text-stone-800">One-Time Payment</span>
              </div>
              <div class="flex justify-between text-xs text-stone-500 font-medium">
                <span>Batch Production & Cold-Chain Delivery</span>
                <span class="font-bold text-emerald-700">Included</span>
              </div>
              <div class="border-t border-stone-200 pt-2 flex justify-between items-center text-sm">
                <span class="font-black text-stone-950">Total Billed Today</span>
                <span id="summary-total-price" class="text-lg font-black text-blue-800">GHS 0.00</span>
              </div>
            </div>

            <div class="bg-blue-50 border border-blue-200/70 rounded-2xl p-4 flex items-start gap-3">
              <span class="text-blue-700 font-black text-base">🛡️</span>
              <p class="text-[11px] text-blue-950 font-medium leading-relaxed">
                <strong>Secure Transaction:</strong> Encrypted and verified instantly via Paystack. Supports MTN MoMo, Telecel Cash, AT Money, and Cards.
              </p>
            </div>

          </div>
        </div>

        <!-- RIGHT COLUMN: Customer Details & Payment Form -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-white rounded-3xl border border-stone-200 shadow-xl p-6 sm:p-8 space-y-6">
            
            <h2 class="text-sm font-black text-stone-900 uppercase tracking-wider border-b border-stone-100 pb-4">
              Delivery & Contact Details
            </h2>

            <form id="checkout-form" class="space-y-4">
              
              <div>
                <label class="block text-[10px] font-bold text-stone-600 uppercase mb-1">Full Name *</label>
                <input id="checkout-name" required placeholder="e.g. Kofi Mensah" class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-blue-700 transition-all" />
              </div>

              <div>
                <label class="block text-[10px] font-bold text-stone-600 uppercase mb-1">WhatsApp / Phone (10 digits) *</label>
                <input 
                  id="checkout-phone" 
                  type="tel" 
                  inputmode="numeric" 
                  required 
                  maxlength="10" 
                  pattern="[0-9]{10}" 
                  placeholder="024XXXXXXX" 
                  class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-blue-700 transition-all" 
                />
              </div>

              <div>
                <label class="block text-[10px] font-bold text-stone-600 uppercase mb-1">Email Address (For receipt) *</label>
                <input id="checkout-email" type="email" required placeholder="kofi@gmail.com" class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-blue-700 transition-all" />
              </div>

              <!-- Recipient Checkbox -->
              <div class="pt-2 border-t border-stone-100">
                <label class="flex items-center gap-2 cursor-pointer select-none">
                  <input type="checkbox" id="different-recipient-checkbox" class="w-4 h-4 rounded text-blue-700 focus:ring-blue-600 border-stone-300" />
                  <span class="text-xs font-bold text-stone-800">Someone else is receiving this delivery</span>
                </label>
              </div>

              <!-- Recipient Drawer -->
              <div id="recipient-section" class="space-y-4 p-4 bg-stone-50 rounded-2xl border border-stone-200/60 hidden">
                <span class="text-[10px] font-black text-blue-900 uppercase tracking-wider block">Recipient Contact Details</span>
                <div>
                  <label class="block text-[10px] font-bold text-stone-600 uppercase mb-1">Recipient Full Name *</label>
                  <input id="recipient-name" placeholder="e.g. Ama Serwaa" class="w-full px-3.5 py-2.5 bg-white border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-blue-700 transition-all" />
                </div>
                <div>
                  <label class="block text-[10px] font-bold text-stone-600 uppercase mb-1">Recipient Phone (10 digits) *</label>
                  <input id="recipient-phone" type="tel" inputmode="numeric" maxlength="10" placeholder="027XXXXXXX" class="w-full px-3.5 py-2.5 bg-white border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-blue-700 transition-all" />
                </div>
              </div>

              <!-- Delivery Schedule & Calendar -->
              <div>
                <div class="flex items-center justify-between mb-1">
                  <label class="block text-[10px] font-bold text-stone-600 uppercase">Delivery Date *</label>
                  <span class="text-[9px] text-stone-400 font-medium">Defaults to next batch cycle</span>
                </div>
                <input 
                  id="checkout-delivery-date" 
                  type="date" 
                  required 
                  class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-blue-700 transition-all cursor-pointer" 
                />
              </div>

              <div>
                <label class="block text-[10px] font-bold text-stone-600 uppercase mb-1">Delivery Address / Landmark *</label>
                <textarea id="checkout-address" required rows="2" placeholder="e.g. East Legon, near ANC Mall..." class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-blue-700 resize-none transition-all"></textarea>
              </div>

              <div>
                <div class="flex items-center justify-between mb-1">
                  <label class="block text-[10px] font-bold text-stone-600 uppercase">Google Maps Pin Link *</label>
                  <button type="button" id="geo-location-btn" class="text-[10px] font-bold text-blue-800 hover:underline cursor-pointer">
                    📍 Use My GPS Location
                  </button>
                </div>
                <input 
                  id="checkout-location-pin" 
                  type="url" 
                  required 
                  placeholder="https://maps.app.goo.gl/... (or tap 'Use My GPS' above)" 
                  class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-blue-700 transition-all" 
                />
              </div>

              <!-- ALLERGIES & DIETARY SENSITIVITIES -->
              <div class="space-y-2 pt-2 border-t border-stone-100">
                <label class="block text-[10px] font-bold text-stone-600 uppercase">Allergies & Dietary Sensitivities</label>
                
                <div class="flex flex-wrap gap-2">
                  <button type="button" class="allergy-chip px-3 py-1.5 rounded-xl text-[11px] font-bold bg-stone-100 text-stone-700 hover:bg-stone-200 transition-all cursor-pointer" data-allergy="Lemon sensitive">
                    🍋 Lemon Sensitive
                  </button>
                  <button type="button" class="allergy-chip px-3 py-1.5 rounded-xl text-[11px] font-bold bg-stone-100 text-stone-700 hover:bg-stone-200 transition-all cursor-pointer" data-allergy="Pineapple allergy">
                    🍍 Pineapple Allergy
                  </button>
                </div>

                <input 
                  id="checkout-allergies" 
                  placeholder="Or type other notes (e.g. ginger sensitivity)..." 
                  class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-blue-700 transition-all" 
                />
                
                <div id="allergy-warning-box" class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-[11px] font-bold text-amber-900 hidden flex items-start gap-2">
                  <span>⚠️</span>
                  <span id="allergy-warning-text">Heads up! Your selection includes ingredients matching your sensitivity.</span>
                </div>
              </div>

              <div class="pt-4">
                <button type="submit" id="submit-checkout-btn" class="w-full py-4 bg-[#1849D6] hover:bg-[#1238A8] text-white font-black rounded-2xl text-xs transition-all shadow-lg flex items-center justify-center gap-2 cursor-pointer">
                  <span>💳 Pay Now Securely (Paystack)</span>
                </button>
              </div>

            </form>

          </div>
        </div>

      </div>

    </div>
  </div>

  <!-- Success Modal -->
  <div id="success-modal" class="fixed inset-0 bg-stone-950/70 backdrop-blur-xs flex items-center justify-center p-4 z-50 hidden">
    <div class="bg-white rounded-3xl max-w-lg w-full p-8 space-y-6 shadow-2xl border border-stone-100 text-left">
      <div class="flex items-center justify-between border-b border-stone-100 pb-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-emerald-100 text-emerald-700 rounded-full flex items-center justify-center font-black text-lg">✓</div>
          <div>
            <span class="text-[10px] font-black uppercase tracking-wider text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full">Payment Confirmed</span>
            <h3 class="text-lg font-black text-stone-950 mt-0.5">Order Placed Successfully</h3>
          </div>
        </div>
        <span id="modal-order-id" class="text-xs font-mono font-bold bg-stone-100 text-stone-800 px-3 py-1.5 rounded-xl">#W0001</span>
      </div>

      <div class="bg-stone-50 rounded-2xl p-4 space-y-2.5 text-xs text-stone-600 border border-stone-200/60 font-medium">
        <div class="flex justify-between">
          <span class="text-stone-400">Payment Gateway:</span>
          <span class="font-bold text-stone-900">Paystack (One-Time Payment)</span>
        </div>
        <div class="flex justify-between">
          <span class="text-stone-400">Transaction Reference:</span>
          <span id="modal-paystack-ref" class="font-mono font-bold text-stone-900">T-REF-XXXXXX</span>
        </div>
      </div>

      <p class="text-xs text-stone-500 font-medium leading-relaxed">
        Thank you for choosing Helthe Juice! Your order ID is <strong id="modal-order-id-text">#W0001</strong>. Track batch progress anytime in your dashboard.
      </p>

      <div class="space-y-3 pt-2">
        <a href="/dashboard" class="w-full py-3.5 bg-blue-800 hover:bg-blue-900 text-white font-black rounded-2xl text-xs transition-all flex items-center justify-center gap-2 cursor-pointer shadow-md">
          <span>View Order in Dashboard →</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Client Script -->
  <script>
    import { auth, db } from '../lib/firebase';
    import { collection, addDoc, serverTimestamp, doc, getDoc } from 'firebase/firestore';
    import { onAuthStateChanged } from 'firebase/auth';

    let currentConfig: any = null;
    let currentUser: any = null;

    const PAYSTACK_PUBLIC_KEY = 'pk_test_8c2d9a51aaca2a886f4b223f6278cbe619edbfca'; 

    const summaryBoxBadge = document.getElementById('summary-box-badge')!;
    const summarySingleCostEl = document.getElementById('summary-single-box-cost')!;
    const summaryPriceEl = document.getElementById('summary-total-price')!;
    const summaryListEl = document.getElementById('summary-items-list')!;
    const checkoutForm = document.getElementById('checkout-form') as HTMLFormElement;
    const geoBtn = document.getElementById('geo-location-btn');
    const locationPinInput = document.getElementById('checkout-location-pin') as HTMLInputElement;
    
    const differentRecipientCheckbox = document.getElementById('different-recipient-checkbox') as HTMLInputElement;
    const recipientSection = document.getElementById('recipient-section') as HTMLElement;
    const deliveryDateInput = document.getElementById('checkout-delivery-date') as HTMLInputElement;

    const allergyChips = document.querySelectorAll('.allergy-chip');
    const allergiesInput = document.getElementById('checkout-allergies') as HTMLInputElement;
    const allergyWarningBox = document.getElementById('allergy-warning-box')!;
    const allergyWarningText = document.getElementById('allergy-warning-text')!;

    // Set Calendar Min Date (Next Week)
    const today = new Date();
    const nextWeekDate = new Date(today);
    nextWeekDate.setDate(today.getDate() + 7);
    deliveryDateInput.min = nextWeekDate.toISOString().split('T')[0];
    deliveryDateInput.value = nextWeekDate.toISOString().split('T')[0];

    // Allergy Quick Chips Toggle & Check
    allergyChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const allergyName = chip.getAttribute('data-allergy') || '';
        chip.classList.toggle('bg-[#1849D6]');
        chip.classList.toggle('text-white');
        chip.classList.toggle('bg-stone-100');
        chip.classList.toggle('text-stone-700');

        let currentVal = allergiesInput.value.split(',').map(s => s.trim()).filter(Boolean);
        if (currentVal.includes(allergyName)) {
          currentVal = currentVal.filter(s => s !== allergyName);
        } else {
          currentVal.push(allergyName);
        }
        allergiesInput.value = currentVal.join(', ');
        checkAllergyConflicts();
      });
    });

    if (allergiesInput) {
      allergiesInput.addEventListener('input', () => checkAllergyConflicts());
    }

    function checkAllergyConflicts() {
      if (!currentConfig || !currentConfig.items) return;
      const notes = allergiesInput.value.toLowerCase();
      const hasLemon = notes.includes('lemon');
      const hasPineapple = notes.includes('pineapple');

      let conflictFound = false;
      let conflictingItem = '';

      currentConfig.items.forEach((item: any) => {
        const combinedName = `${item.name || ''} ${item.englishName || ''}`.toLowerCase();
        if (hasLemon && (combinedName.includes('lemon') || combinedName.includes('citrus'))) {
          conflictFound = true;
          conflictingItem = item.name;
        }
        if (hasPineapple && (combinedName.includes('pineapple') || combinedName.includes('ananas'))) {
          conflictFound = true;
          conflictingItem = item.name;
        }
      });

      if (conflictFound) {
        allergyWarningText.textContent = `Heads up! "${conflictingItem}" in your box matches your dietary sensitivity.`;
        allergyWarningBox.classList.remove('hidden');
      } else {
        allergyWarningBox.classList.add('hidden');
      }
    }

    differentRecipientCheckbox.addEventListener('change', () => {
      if (differentRecipientCheckbox.checked) {
        recipientSection.classList.remove('hidden');
        (document.getElementById('recipient-name') as HTMLInputElement).required = true;
        (document.getElementById('recipient-phone') as HTMLInputElement).required = true;
      } else {
        recipientSection.classList.add('hidden');
        (document.getElementById('recipient-name') as HTMLInputElement).required = false;
        (document.getElementById('recipient-phone') as HTMLInputElement).required = false;
      }
    });

    onAuthStateChanged(auth, async (user) => {
      if (!user) {
        sessionStorage.setItem('helthe_auth_redirect', '/checkout');
        window.location.href = '/login';
        return;
      }
      currentUser = user;
      const emailInput = document.getElementById('checkout-email') as HTMLInputElement;
      if (emailInput && !emailInput.value) emailInput.value = user.email || '';

      try {
        const userDocSnap = await getDoc(doc(db, 'users', user.uid));
        if (userDocSnap.exists()) {
          const profile = userDocSnap.data();
          const nameInput = document.getElementById('checkout-name') as HTMLInputElement;
          const phoneInput = document.getElementById('checkout-phone') as HTMLInputElement;
          const addressInput = document.getElementById('checkout-address') as HTMLTextAreaElement;
          const pinInput = document.getElementById('checkout-location-pin') as HTMLInputElement;

          if (nameInput && !nameInput.value) nameInput.value = profile.name || '';
          if (phoneInput && !phoneInput.value) phoneInput.value = profile.phone || '';
          if (addressInput && !addressInput.value) addressInput.value = profile.address || '';
          if (pinInput && !pinInput.value) pinInput.value = profile.locationPin || '';
          if (profile.allergies) {
            allergiesInput.value = profile.allergies;
            checkAllergyConflicts();
          }
        }
      } catch (err) {
        console.error('Error fetching user profile:', err);
      }
    });

    // Load Box Config (Bottles or Pouches only)
    const rawConfig = sessionStorage.getItem('helthe_box_config');
    if (!rawConfig) {
      alert('No selection found. Redirecting to order builder...');
      window.location.href = '/order';
    } else {
      currentConfig = JSON.parse(rawConfig);
      if (currentConfig.category && currentConfig.category !== 'juices' && currentConfig.category !== 'pouches') {
        sessionStorage.removeItem('helthe_box_config');
        window.location.href = '/order';
      }

      const orderAmount = Number(currentConfig.basePrice ?? currentConfig.totalPrice) || 0;
      currentConfig.totalPrice = orderAmount;

      summarySingleCostEl.textContent = `GHS ${orderAmount.toFixed(2)}`;
      summaryPriceEl.textContent = `GHS ${orderAmount.toFixed(2)}`;
      summaryBoxBadge.textContent = currentConfig.category === 'pouches' ? 'Juice Pouches (One-Time)' : 'Juice Bottles (One-Time)';

      summaryListEl.innerHTML = currentConfig.items.map((item: any) => `
      <li class="py-2 flex justify-between items-center gap-2">
        <div>
          <span class="font-bold text-stone-900">${item.name}</span>
          ${item.customUnitPrice ? `<span class="ml-2 px-2 py-0.5 rounded bg-amber-100 text-amber-950 text-[10px] font-black">Custom · GHS ${item.customUnitPrice}/bottle</span>` : ''}
        </div>
        <span class="px-2.5 py-1 bg-blue-50 text-blue-900 rounded-lg text-xs font-black shrink-0">${item.qty} units</span>
      </li>
    `).join('');
    

      checkAllergyConflicts();
    }

    if (geoBtn && locationPinInput) {
      geoBtn.addEventListener('click', () => {
        if (!navigator.geolocation) return alert('Geolocation unsupported');
        geoBtn.textContent = '⌛ Getting GPS...';
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            locationPinInput.value = `https://maps.google.com/?q=${pos.coords.latitude},${pos.coords.longitude}`;
            geoBtn.textContent = '✓ Pin Captured!';
            geoBtn.className = 'text-[10px] font-bold text-emerald-700';
          },
          () => {
            alert('Unable to retrieve GPS. Please check location permissions.');
            geoBtn.textContent = '📍 Use My GPS Location';
          }
        );
      });
    }

    function generateOrderCode() {
      return `W${Math.floor(1000 + Math.random() * 9000)}`;
    }

    async function sendOrderSuccessSMS(orderData: any) {
      try {
        const phone = orderData.recipient.isDifferentPerson ? orderData.recipient.phone : orderData.buyer.phone;
        const msg = `Hi ${orderData.buyer.name}! Helthe Juice order ${orderData.orderCode} confirmed. Delivery: ${orderData.delivery.scheduledDate}. Total: GHS ${(orderData.total/100).toFixed(2)}.`;
        await fetch('/api/send-sms', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ phone, message: msg }) });

        const allergyNote = orderData.delivery.notes ? ` | Allergies: ${orderData.delivery.notes}` : '';
        const ownerMsg = `🚨 New Paid Order (${orderData.orderCode})! Customer: ${orderData.buyer.name} (${phone}). Total: GHS ${(orderData.total/100).toFixed(2)}. Scheduled: ${orderData.delivery.scheduledDate}${allergyNote}.`;
        await fetch('/api/send-sms', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ phone: '0547000817', message: ownerMsg }) });
      } catch (err) {
        console.error('SMS error:', err);
      }
    }

    async function handlePaystackSuccess(response: any, payload: any) {
      try {
        await addDoc(collection(db, 'orders'), payload);
        await sendOrderSuccessSMS(payload);
        sessionStorage.removeItem('helthe_box_config');

        document.getElementById('modal-order-id')!.textContent = `#${payload.orderCode}`;
        document.getElementById('modal-order-id-text')!.textContent = `#${payload.orderCode}`;
        document.getElementById('modal-paystack-ref')!.textContent = response.reference;
        document.getElementById('success-modal')!.classList.remove('hidden');
      } catch (err: any) {
        alert('Payment verified, but saving order failed: ' + response.reference);
      }
    }

    checkoutForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const buyerName = (document.getElementById('checkout-name') as HTMLInputElement).value.trim();
      const buyerPhoneInput = document.getElementById('checkout-phone') as HTMLInputElement;
      const buyerPhone = buyerPhoneInput.value.replace(/\D/g, '');

      if (buyerPhone.length !== 10) return alert('Enter a valid 10-digit phone number.');

      const email = (document.getElementById('checkout-email') as HTMLInputElement).value.trim();
      const address = (document.getElementById('checkout-address') as HTMLTextAreaElement).value.trim();
      const locationPin = locationPinInput.value.trim();
      const allergies = allergiesInput.value.trim();
      const scheduledDate = deliveryDateInput.value;

      const isDifferent = differentRecipientCheckbox.checked;
      const recipientName = isDifferent ? (document.getElementById('recipient-name') as HTMLInputElement).value.trim() : buyerName;
      const recipientPhone = isDifferent ? (document.getElementById('recipient-phone') as HTMLInputElement).value.replace(/\D/g, '') : buyerPhone;

      const amountInPesewas = Math.round(currentConfig.totalPrice * 100);
      const customOrderCode = generateOrderCode();

      const orderDataPayload = {
        orderCode: customOrderCode,
        orderType: `Order (${currentConfig.category === 'pouches' ? 'Juice Pouches' : 'Juice Bottles'})`,
        category: currentConfig.category || 'juices',
        isSubscription: false,
        frequency: null,
        planCode: null,
        userId: currentUser?.uid || null,
        buyer: { name: buyerName, phone: buyerPhone, email },
        recipient: { isDifferentPerson: isDifferent, name: recipientName, phone: recipientPhone },
        delivery: { scheduledDate, address, locationPin, notes: allergies },
        items: currentConfig.items.map((i: any) => ({ name: i.name, qty: i.qty })),
        total: amountInPesewas,
        paymentStatus: 'paid',
        status: 'processing',
        paymentGateway: 'paystack',
        paystackReference: '',
        paidAt: '',
        createdAt: serverTimestamp()
      };

      const paystackConfig: any = {
        key: PAYSTACK_PUBLIC_KEY,
        email,
        amount: amountInPesewas,
        currency: 'GHS',
        ref: `${customOrderCode}-${Date.now()}`,
        metadata: {
          custom_fields: [
            { display_name: "Order Code", variable_name: "order_code", value: customOrderCode },
            { display_name: "Buyer Name", variable_name: "buyer_name", value: buyerName },
            { display_name: "Recipient Name", variable_name: "recipient_name", value: recipientName },
            { display_name: "Delivery Date", variable_name: "delivery_date", value: scheduledDate }
          ]
        },
        callback: function(response: any) {
          orderDataPayload.paystackReference = response.reference;
          orderDataPayload.paidAt = new Date().toISOString();
          handlePaystackSuccess(response, orderDataPayload);
        }
      };

      const paystackHandler = (window as any).PaystackPop.setup(paystackConfig);
      paystackHandler.openIframe();
    });
  </script>
</MainLayout>