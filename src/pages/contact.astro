---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Contact Us — Helthe Juice"
  description="Get in touch with Helthe Juice for juice bundle orders, event refreshments, or friendly support."
>
  <section class="min-h-screen bg-[#fdfaf5] pt-14 mb-40 sm:py-20 px-4 sm:px-6" id="section-contact">
    <div class="max-w-6xl mx-auto space-y-12">

      <!-- Warm Editorial Header -->
      <div class="bg-[#c88a5b] rounded-3xl p-7 sm:p-10 text-[#fdfaf5] shadow-xl flex flex-col md:flex-row md:items-end justify-between gap-6" data-reveal>
        <div class="space-y-3 max-w-2xl">
          <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#fdfaf5] text-blue-900 text-[10px] font-black uppercase tracking-wider shadow-2xs">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Friendly Support · Quick Response</span>
          </span>
          <h1 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight">
            Let’s talk fresh blends &amp; orders.
          </h1>
          <p class="text-xs sm:text-sm text-[#fdfaf5]/95 font-medium leading-relaxed">
            Have a question about our 350ml bottle bundles, custom Apple Beetroot Carrot (ABC) orders, delivery dates, or event refreshments? Reach out anytime.
          </p>
        </div>

        <div class="bg-[#fdfaf5] text-stone-950 px-5 py-4 rounded-2xl shadow-md shrink-0">
          <span class="text-[10px] font-black uppercase tracking-wider text-stone-500 block">Direct Line</span>
          <a href="tel:+233547000817" class="text-base sm:text-lg font-black text-blue-800 hover:underline">
            +233 54 700 0817
          </a>
        </div>
      </div>

      <!-- Two-Column Contact Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- LEFT COLUMN: Contact Channels & Warm Note (5 Cols) -->
        <div class="lg:col-span-5 space-y-6" data-reveal="left">
          <div class="bg-white rounded-3xl border border-stone-200/90 shadow-lg p-6 sm:p-8 space-y-6">
            <div class="space-y-1.5 border-b border-stone-100 pb-4">
              <span class="text-[10px] font-black uppercase tracking-wider text-blue-800">Reach Out Directly</span>
              <h2 class="text-xl font-black text-stone-950">Contact Details</h2>
              <p class="text-xs text-stone-600 leading-relaxed">
                Tap any option below to call, email, or message us directly on WhatsApp.
              </p>
            </div>

            <ul class="space-y-4">
              <li>
                <a
                  href="tel:+233547000817"
                  class="group flex items-center gap-4 p-3.5 rounded-2xl bg-[#fdfaf5] hover:bg-blue-50/70 border border-stone-200/80 hover:border-blue-300 transition-all"
                >
                  <span class="w-12 h-12 rounded-2xl bg-blue-800 group-hover:bg-blue-900 text-white flex items-center justify-center shrink-0 shadow-xs transition-colors">
                    <i class="fa-solid fa-phone text-sm"></i>
                  </span>
                  <div>
                    <p class="text-[11px] font-bold uppercase tracking-wider text-stone-500">Call Us</p>
                    <h3 class="text-sm sm:text-base font-black text-stone-950 group-hover:text-blue-900 transition-colors">
                      +233 54 700 0817
                    </h3>
                  </div>
                </a>
              </li>

              <li>
                <a
                  href="mailto:helthegh@gmail.com"
                  class="group flex items-center gap-4 p-3.5 rounded-2xl bg-[#fdfaf5] hover:bg-blue-50/70 border border-stone-200/80 hover:border-blue-300 transition-all"
                >
                  <span class="w-12 h-12 rounded-2xl bg-blue-800 group-hover:bg-blue-900 text-white flex items-center justify-center shrink-0 shadow-xs transition-colors">
                    <i class="fa-solid fa-envelope text-sm"></i>
                  </span>
                  <div>
                    <p class="text-[11px] font-bold uppercase tracking-wider text-stone-500">Send Us an Email</p>
                    <h3 class="text-sm sm:text-base font-black text-stone-950 group-hover:text-blue-900 transition-colors break-all">
                      helthegh@gmail.com
                    </h3>
                  </div>
                </a>
              </li>

              <li>
                <a
                  href="https://wa.me/233547000817"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-4 p-3.5 rounded-2xl bg-[#fdfaf5] hover:bg-emerald-50/70 border border-stone-200/80 hover:border-emerald-300 transition-all"
                >
                  <span class="w-12 h-12 rounded-2xl bg-emerald-700 group-hover:bg-emerald-800 text-white flex items-center justify-center shrink-0 shadow-xs transition-colors">
                    <i class="fa-brands fa-whatsapp text-base"></i>
                  </span>
                  <div>
                    <p class="text-[11px] font-bold uppercase tracking-wider text-stone-500">WhatsApp Chat</p>
                    <h3 class="text-sm sm:text-base font-black text-stone-950 group-hover:text-emerald-900 transition-colors">
                      +233 54 700 0817
                    </h3>
                  </div>
                </a>
              </li>
            </ul>

            <div class="bg-amber-50 border border-amber-200/80 rounded-2xl p-4 flex items-center justify-between gap-3">
              <div>
                <p class="text-xs font-black text-stone-950">Ready to build a bundle?</p>
                <p class="text-[11px] text-stone-600">Select 6, 15, 20, or 30 cold-pressed bottles.</p>
              </div>
              <a
                href="/order"
                class="px-4 py-2 rounded-full bg-amber-300 hover:bg-amber-200 text-stone-950 text-xs font-black whitespace-nowrap transition-all shadow-2xs"
              >
                Order Now
              </a>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: Netlify Form (7 Cols) -->
        <div class="lg:col-span-7" data-reveal="right">
          <form
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="bg-white rounded-3xl border border-stone-200/90 shadow-xl p-6 sm:p-10 space-y-5"
          >
            <input type="hidden" name="form-name" value="contact" />

            <p class="hidden">
              <label>
                Don’t fill this out if you’re human:
                <input name="bot-field" />
              </label>
            </p>

            <div class="border-b border-stone-100 pb-4 space-y-1">
              <span class="text-[10px] font-black uppercase tracking-wider text-blue-800">Drop a Note</span>
              <h2 class="text-2xl font-black text-stone-950">Send Us a Message</h2>
              <p class="text-xs text-stone-500">
                Tell us what you need and we will get back to you as soon as possible.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="fname" class="block text-[11px] font-black uppercase tracking-wider text-stone-700 mb-1.5">
                  Your Name *
                </label>
                <input
                  type="text"
                  name="fname"
                  id="fname"
                  placeholder="Nana Agyemang"
                  required
                  class="w-full px-4 py-3 rounded-2xl bg-[#fdfaf5] border border-stone-200 text-xs sm:text-sm font-bold text-stone-900 placeholder:text-stone-400 placeholder:font-medium focus:outline-none focus:border-blue-700 focus:bg-white transition-all"
                />
              </div>

              <div>
                <label for="wnum" class="block text-[11px] font-black uppercase tracking-wider text-stone-700 mb-1.5">
                  WhatsApp / Phone *
                </label>
                <input
                  type="tel"
                  name="wnum"
                  id="wnum"
                  placeholder="024XXXXXXX or +233..."
                  required
                  class="w-full px-4 py-3 rounded-2xl bg-[#fdfaf5] border border-stone-200 text-xs sm:text-sm font-bold text-stone-900 placeholder:text-stone-400 placeholder:font-medium focus:outline-none focus:border-blue-700 focus:bg-white transition-all"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-[11px] font-black uppercase tracking-wider text-stone-700 mb-1.5">
                Email Address (Optional)
              </label>
              <input
                type="email"
                name="email"
                id="email"
                placeholder="you@example.com"
                class="w-full px-4 py-3 rounded-2xl bg-[#fdfaf5] border border-stone-200 text-xs sm:text-sm font-bold text-stone-900 placeholder:text-stone-400 placeholder:font-medium focus:outline-none focus:border-blue-700 focus:bg-white transition-all"
              />
            </div>

            <div>
              <label for="message" class="block text-[11px] font-black uppercase tracking-wider text-stone-700 mb-1.5">
                Message *
              </label>
              <textarea
                name="message"
                id="message"
                rows="5"
                placeholder="Share your questions, custom order notes, or event details..."
                required
                class="w-full px-4 py-3 rounded-2xl bg-[#fdfaf5] border border-stone-200 text-xs sm:text-sm font-bold text-stone-900 placeholder:text-stone-400 placeholder:font-medium focus:outline-none focus:border-blue-700 focus:bg-white transition-all resize-none"
              ></textarea>
            </div>

            <div class="pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              
              <button
                type="submit"
                class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-blue-800 hover:bg-blue-900 text-white text-xs sm:text-sm font-black tracking-wide transition-all shadow-lg hover:-translate-y-0.5 active:translate-y-0 cursor-pointer inline-flex items-center justify-center gap-2"
              >
                <span>Send Message</span>
                <i class="fa-solid fa-paper-plane text-xs"></i>
              </button>
            </div>
          </form>
        </div>

      </div>
    </div>
  </section>
</MainLayout>