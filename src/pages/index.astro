---
import Faq from '../components/Faq.astro';
import MainLayout from '../layouts/MainLayout.astro';
import Hwave from "../assets/h-wave.png";
import { Image } from 'astro:assets';
import NanaWelcome from "../assets/nana-owusua-helthe.png";
import EventImage from "../assets/event-catering.png";

// products
import Cucpinmint from "../assets/products/cucumber-pineapple-mint.jpg";
import Cucpinspin from "../assets/products/cucumber-pineapple-spinach.png";
import OrangeCarrot from "../assets/products/orange-carrot.png";
import Watermelon from "../assets/products/watermelon.png";
import MangoMelon from "../assets/products/watermelon-mango.png";
import BeetMelon from "../assets/products/watermelon-beetroot.png";
import nana from "../assets/Mask group.png";
import thankyou from "../assets/Mask group-1.png";
import watermelon from "../assets/Mask group-2.png";

// French names only for the juices & product items
const signatureProducts = [
	{
		frenchName: "Ananas, Concombre & Menthe",
		category: "Bottle · 350ml",
		badgeTone: "bg-emerald-600 text-white",
		image: Cucpinmint,
		alt: "Ananas, Concombre & Menthe"
	},
	{
		frenchName: "Pastèque Rouge Fraîche",
		category: "Bottle · 350ml",
		badgeTone: "bg-rose-600 text-white",
		image: Watermelon,
		alt: "Pastèque Rouge Fraîche"
	},
	{
		frenchName: "Pastèque & Betterave",
		category: "Bottle · 350ml",
		badgeTone: "bg-amber-500 text-stone-950",
		image: BeetMelon,
		alt: "Pastèque & Betterave"
	},
	{
		frenchName: "Jus d’Orange & Carotte",
		category: "Bottle · 350ml",
		badgeTone: "bg-orange-500 text-white",
		image: OrangeCarrot,
		alt: "Jus d’Orange & Carotte"
	},
	{
		frenchName: "Ananas, Concombre & Épinard",
		category: "Pouch · 4pcs",
		badgeTone: "bg-teal-600 text-white",
		image: Cucpinspin,
		alt: "Ananas, Concombre & Épinard"
	},
	{
		frenchName: "Pastèque & Mangue Dorée",
		category: "Chia & Smoothie",
		badgeTone: "bg-blue-700 text-white",
		image: MangoMelon,
		alt: "Pastèque & Mangue Dorée"
	}
];

const extraOfferings = [
	{ frenchName: "Pudding d’Amande et Chia", tag: "Chia Pudding" },
	{ frenchName: "Pudding de Noix de Cajou et Chia", tag: "Chia Pudding" },
	{ frenchName: "Pochon Ananas & Mangue", tag: "Pouch Pack" },
	{ frenchName: "Shot de Gingembre Pur", tag: "Wellness Shot" },
	{ frenchName: "Shot Betterave, Menthe & Citron Vert", tag: "Wellness Shot" },
	{ frenchName: "Corbeille de Fruits Frais", tag: "Fresh Fruits" }
];
---

<MainLayout title="Helthe Juice | Freshness Crafted Daily">

	<!-- Editorial Collage Hero -->
	<section class="relative overflow-hidden bg-[#c88a5b] text-stone-950 pt-10 pb-28 md:pt-14 md:pb-36" id="section-hero">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
				<!-- Left Editorial Copy -->
				<div class="lg:col-span-6 space-y-5 text-center lg:text-left" data-reveal="left">
					<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#fdfaf5] text-blue-900 text-xs font-extrabold tracking-wide shadow-sm">
						<span class="w-2 h-2 rounded-full bg-emerald-500"></span>
						<span>100% Real Fruit · Made Fresh Daily</span>
					</div>

					<h1 class="font-black tracking-tight leading-[0.98] text-5xl sm:text-6xl lg:text-7xl text-[#fdfaf5] drop-shadow-xs">
						refresh<br />
						every sip.<br />
						feel <span class="inline-block px-3 py-0.5 rounded-xl bg-amber-300 text-stone-950 -rotate-1">pure</span><br />
						every day.
					</h1>

					<p class="text-sm sm:text-base font-medium text-[#fdfaf5]/95 max-w-lg mx-auto lg:mx-0 leading-relaxed">
						Cold-pressed bottles, handy pouches, creamy chia puddings, fresh fruits, and wellness shots crafted for how you live.
					</p>

					<div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 pt-2">
						<a href="/order" class="px-6 py-3.5 rounded-full bg-blue-800 hover:bg-blue-900 text-white text-xs sm:text-sm font-black tracking-wide transition-all shadow-lg hover:-translate-y-0.5 active:translate-y-0">
							Order Now
						</a>
						<a href="/juices" class="px-6 py-3.5 rounded-full bg-[#fdfaf5] hover:bg-amber-100 text-stone-950 text-xs sm:text-sm font-extrabold tracking-wide transition-all shadow-md hover:-translate-y-0.5 active:translate-y-0">
							Explore Menu
						</a>
					</div>
				</div>

				<!-- Right Tilted Photo Collage & French Product Pill -->
				<div class="lg:col-span-6 relative flex items-center justify-center min-h-[360px] sm:min-h-[430px]" data-reveal="right">
					<div class="relative w-64 sm:w-72 rounded-3xl overflow-hidden bg-[#fdfaf5] p-2.5 shadow-2xl border-2 border-white/80 animate-float-card z-10">
						<Image src={OrangeCarrot} alt="Jus d’Orange & Carotte" class="w-full h-64 sm:h-72 object-contain rounded-2xl bg-amber-50 p-3" />
						<div class="pt-2.5 pb-1 px-2 flex items-center justify-between gap-2">
							<span class="text-xs font-black text-stone-900 truncate">Jus d’Orange &amp; Carotte</span>
							<span class="px-2 py-0.5 rounded-full bg-blue-100 text-blue-900 text-[10px] font-extrabold shrink-0">Fresh</span>
						</div>
					</div>

					<div class="hidden sm:block absolute -right-2 top-6 w-44 rounded-2xl overflow-hidden bg-white p-2 shadow-xl border border-amber-200 animate-float-card-alt z-20">
						<Image src={Cucpinmint} alt="Ananas, Concombre & Menthe" class="w-full h-32 object-contain rounded-xl bg-emerald-50/70 p-2" />
						<span class="mt-1.5 block text-[11px] font-black text-emerald-900 text-center bg-amber-200/90 py-1 rounded-lg">
							Ananas &amp; Menthe
						</span>
					</div>

					<div class="hidden sm:block absolute -left-2 bottom-4 w-44 rounded-2xl overflow-hidden bg-rose-600 text-white p-2.5 shadow-xl rotate-[-4deg] hover:rotate-0 transition-transform duration-300 z-20">
						<Image src={Watermelon} alt="Pastèque Rouge Fraîche" class="w-full h-28 object-contain rounded-xl bg-white/95 p-2" />
						<div class="mt-2 text-center">
							<span class="block text-[11px] font-black tracking-tight">Pastèque Rouge Fraîche</span>
							<span class="text-[9px] uppercase tracking-wider text-rose-100 font-bold">Zero Additives</span>
						</div>
					</div>
				</div>
			</div>
		</div>

		<Image src={Hwave} alt="Helthe Juice wave divider" class="w-full h-24 md:h-40 absolute left-0 bottom-0 pointer-events-none object-cover" />
	</section>

	<!-- Warm Welcome & Story Section -->
	<section class="py-20 md:py-24 bg-[#fdfaf5]" id="section-story">
		<div class="max-w-6xl mx-auto px-4 sm:px-6">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
				<div class="lg:col-span-6 space-y-6" data-reveal="left">
					<span class="inline-block px-3.5 py-1 rounded-full bg-blue-100 text-blue-900 text-xs font-extrabold uppercase tracking-wider">
						Welcome to Helthe Juice
					</span>

					<h2 class="text-3xl sm:text-4xl font-black tracking-tight text-stone-950 leading-tight">
						Real ingredients, honest craft, and a warm welcome in every bottle.
					</h2>

					<p class="text-sm sm:text-base text-stone-700 leading-relaxed">
						Helthe Juice began with a simple belief: what you put into your body should feel wholesome, refreshing, and full of life. Founded by Nana Owusua, Helthe celebrates vibrant harvests with blends crafted to brighten busy mornings, workouts, and everyday moments.
					</p>

					<p class="text-sm sm:text-base text-stone-700 leading-relaxed">
						No artificial colours, no preservatives, and no shortcuts—just crisp juices, easy-carry pouches, smoothies, chia puddings, fresh fruits, and energizing shots made with care.
					</p>

					<div class="grid grid-cols-3 gap-4 pt-2">
						<div class="rounded-2xl overflow-hidden bg-white p-1.5 shadow-sm border border-stone-200/80 hover:-translate-y-1 transition-transform">
							<Image src={nana} alt="Nana Owusua holding Helthe Juice" class="w-full h-28 sm:h-32 object-cover rounded-xl" />
						</div>
						<div class="rounded-2xl overflow-hidden bg-white p-1.5 shadow-sm border border-stone-200/80 hover:-translate-y-1 transition-transform">
							<Image src={thankyou} alt="Helthe Juice care pack" class="w-full h-28 sm:h-32 object-cover rounded-xl" />
						</div>
						<div class="rounded-2xl overflow-hidden bg-white p-1.5 shadow-sm border border-stone-200/80 hover:-translate-y-1 transition-transform">
							<Image src={watermelon} alt="Fresh watermelon blend" class="w-full h-28 sm:h-32 object-cover rounded-xl" />
						</div>
					</div>
				</div>

				<div class="lg:col-span-6" data-reveal="right">
					<div class="relative rounded-3xl bg-amber-100/80 p-4 sm:p-6 border border-amber-200/80 shadow-lg">
						<Image src={NanaWelcome} alt="Nana Owusua smiling with Helthe Juice" class="w-full rounded-2xl object-cover shadow-md" />
						<div class="mt-4 flex items-center justify-between bg-white rounded-2xl px-4 py-3 shadow-xs border border-stone-100">
							<div>
								<p class="text-xs font-black text-stone-900">Handcrafted in Small Batches</p>
								<p class="text-[11px] text-stone-500">Freshly prepared &amp; chilled for delivery</p>
							</div>
							<span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 text-[11px] font-extrabold">
								100% Natural
							</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Warm Caramel Card Showcase (French Product Names Only) -->
	<section class="py-20 md:py-24 bg-[#c88a5b] text-stone-950 relative" id="section-flavors">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-12">
			<div class="flex flex-col md:flex-row md:items-end justify-between gap-4" data-reveal>
				<div class="space-y-2">
					<span class="inline-block px-3.5 py-1 rounded-full bg-[#fdfaf5] text-blue-900 text-xs font-extrabold uppercase tracking-wider">
						Signature Lineup
					</span>
					<h2 class="text-3xl sm:text-5xl font-black tracking-tight text-[#fdfaf5]">
						Explore Our Taste
					</h2>
				</div>
				<p class="text-xs sm:text-sm font-semibold text-[#fdfaf5]/90 max-w-md">
					Pick your favourite blends, pouches, chia puddings, or shots and customize your bundle in seconds.
				</p>
			</div>

			<!-- 6 Signature Cards on Warm Caramel Backdrop -->
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
				{signatureProducts.map((item, idx) => (
					<div
						class="group bg-[#fdfaf5] rounded-3xl p-5 shadow-lg border border-white/70 flex flex-col justify-between transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl"
						data-reveal
						style={`transition-delay: ${idx * 65}ms;`}
					>
						<div>
							<div class="flex items-center justify-between gap-2 mb-3">
								<span class="text-[11px] font-extrabold uppercase tracking-wider text-stone-500">
									{item.category}
								</span>
								<span class={`px-2.5 py-0.5 rounded-full text-[10px] font-black ${item.badgeTone}`}>
									Fresh
								</span>
							</div>

							<div class="h-52 rounded-2xl bg-amber-50/80 border border-amber-200/50 flex items-center justify-center p-4 overflow-hidden">
								<Image
									src={item.image}
									alt={item.frenchName}
									class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-110"
								/>
							</div>
						</div>

						<div class="pt-4 mt-4 border-t border-stone-200/70 flex items-center justify-between gap-3">
							<h3 class="font-black text-base sm:text-lg text-stone-950 leading-snug">
								{item.frenchName}
							</h3>
							<a
								href="/order"
								class="w-9 h-9 rounded-full bg-blue-800 hover:bg-blue-900 text-white flex items-center justify-center shrink-0 transition-transform group-hover:translate-x-0.5"
								aria-label={`Order ${item.frenchName}`}
							>
								<i class="fa-solid fa-plus text-xs"></i>
							</a>
						</div>
					</div>
				))}
			</div>

			<!-- More Offerings Strip (French Names for Items) -->
			<div class="bg-[#fdfaf5] rounded-3xl p-6 sm:p-8 shadow-xl border border-white/80 space-y-5" data-reveal>
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-stone-200/80 pb-4">
					<div>
						<h3 class="text-lg sm:text-xl font-black text-stone-950">
							More Offerings · Pouches, Chia Pudding &amp; Shots
						</h3>
						<p class="text-xs text-stone-600 font-medium">
							Also available across our multi-category order builder and subscriptions.
						</p>
					</div>
					<a href="/order" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-blue-800 hover:bg-blue-900 text-white text-xs font-black transition-all self-start sm:self-auto">
						<span>Build Custom Order</span>
						<i class="fa-solid fa-arrow-right text-[10px]"></i>
					</a>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
					{extraOfferings.map((extra) => (
						<a
							href="/order"
							class="flex items-center justify-between gap-3 px-4 py-3 rounded-2xl bg-amber-50/80 hover:bg-amber-100 border border-amber-200/70 transition-all group"
						>
							<span class="font-bold text-xs sm:text-sm text-stone-900">
								{extra.frenchName}
							</span>
							<span class="text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full bg-white text-blue-900 border border-blue-100 shrink-0 group-hover:bg-blue-800 group-hover:text-white transition-colors">
								{extra.tag}
							</span>
						</a>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- Event & Wellness Section -->
	<section class="py-20 md:py-24 bg-[#fdfaf5]" id="section-events">
		<div class="max-w-6xl mx-auto px-4 sm:px-6">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
				<div class="lg:col-span-6" data-reveal="left">
					<div class="rounded-3xl overflow-hidden shadow-xl border border-stone-200/80 bg-white p-3">
						<Image src={EventImage} alt="Helthe Juice serving at an event" class="w-full rounded-2xl object-cover" />
					</div>
				</div>

				<div class="lg:col-span-6 space-y-5" data-reveal="right">
					<span class="inline-block px-3.5 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-extrabold uppercase tracking-wider">
						Events &amp; Gatherings
					</span>
					<h2 class="text-3xl sm:text-4xl font-black tracking-tight text-stone-950">
						Sip your way to wellness at every gathering.
					</h2>
					<p class="text-sm sm:text-base text-stone-700 leading-relaxed">
						From office wellness days and brunches to celebrations and pop-ups, bring fresh, crowd-pleasing drinks and treats your guests will genuinely enjoy.
					</p>
					<p class="text-sm sm:text-base text-stone-700 leading-relaxed">
						Healthy choices feel effortless when they taste this good—ready for one-time orders or recurring deliveries.
					</p>
					<div class="pt-2">
						<a href="/order" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-blue-800 hover:bg-blue-900 text-white text-xs sm:text-sm font-black transition-all shadow-md hover:-translate-y-0.5">
							<span>Order Now</span>
							<i class="fa-solid fa-arrow-right text-xs"></i>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Warm Closing Callout -->
	<section class="py-20 md:py-28 bg-amber-100/75 border-y border-amber-200/80">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-6" data-reveal>
			<span class="inline-block px-4 py-1 rounded-full bg-white text-blue-900 text-xs font-black uppercase tracking-wider shadow-2xs">
				Fresh · Friendly · Delivered
			</span>
			<h2 class="text-3xl sm:text-5xl font-black tracking-tight text-stone-950">
				Ready to go down the Helthe path?
			</h2>
			<p class="text-sm sm:text-base text-stone-700 max-w-xl mx-auto leading-relaxed">
				No refined sugar, no preservatives, and no compromise—just real fruit goodness and fresh energy made to order.
			</p>
			<div class="pt-2 flex flex-wrap items-center justify-center gap-3">
				<a href="/order" class="px-7 py-4 rounded-full bg-blue-800 hover:bg-blue-900 text-white text-xs sm:text-sm font-black transition-all shadow-lg hover:-translate-y-0.5">
					Start Your Order
				</a>
				<a href="/juices" class="px-7 py-4 rounded-full bg-white hover:bg-stone-50 text-stone-950 border border-stone-300 text-xs sm:text-sm font-extrabold transition-all">
					View Full Menu
				</a>
			</div>
		</div>
	</section>

	<!-- FAQ -->
	<Faq />
</MainLayout>