---
// src/pages/login.astro
export const prerender = false;
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Sign In or Register — Helthe Juice">
  <div class="min-h-screen bg-stone-50 py-10 px-4 sm:px-6 pt-32 pb-40 font-sans">
    <div class="max-w-md mx-auto space-y-6">
      
      <div class="bg-white rounded-3xl border border-stone-200 shadow-xl p-6 sm:p-8 space-y-6">

        <!-- Visual Tab Switcher -->
        <div class="grid grid-cols-2 p-1 bg-stone-100 rounded-2xl border border-stone-200">
          <button 
            type="button" 
            id="tab-signin" 
            class="py-2.5 rounded-xl text-xs font-black transition-all bg-white text-stone-950 shadow-xs"
          >
            Sign In
          </button>
          <button 
            type="button" 
            id="tab-signup" 
            class="py-2.5 rounded-xl text-xs font-black transition-all text-stone-500 hover:text-stone-900"
          >
            Create Account
          </button>
        </div>
        
        <!-- Header -->
        <div class="text-center space-y-1">
          <span class="px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full text-[10px] font-black uppercase tracking-wider">Helthe Account</span>
          <h1 id="auth-title" class="text-2xl font-black text-stone-950 tracking-tight pt-2">Welcome Back</h1>
          <p id="auth-subtitle" class="text-xs text-stone-500 font-medium">Sign in to track orders, manage allergies, and re-order in seconds.</p>
        </div>

        <!-- Google Sign-In Button -->
        <button type="button" id="google-auth-btn" class="w-full py-3 px-4 bg-stone-100 hover:bg-stone-200 text-stone-900 font-bold rounded-2xl text-xs transition-all flex items-center justify-center gap-3 border border-stone-200">
          <svg class="w-4 h-4" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span>Continue with Google</span>
        </button>

        <div class="relative flex items-center justify-center">
          <div class="border-t border-stone-200 w-full"></div>
          <span class="bg-white px-3 text-[10px] font-black uppercase text-stone-400">Or with Email</span>
        </div>

        <!-- Form -->
        <form id="auth-form" class="space-y-4">
          <!-- Signup Extra Fields -->
          <div id="signup-extra-fields" class="space-y-4 hidden">
            <div>
              <label class="block text-[10px] font-bold text-stone-600 uppercase mb-1">Full Name *</label>
              <input id="auth-name" type="text" placeholder="Kofi Mensah" class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-emerald-500" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-[10px] font-bold text-stone-600 uppercase mb-1">WhatsApp / Phone (10 digits) *</label>
                <input 
                  id="auth-phone" 
                  type="tel" 
                  inputmode="numeric" 
                  maxlength="10" 
                  pattern="[0-9]{10}" 
                  placeholder="024XXXXXXX" 
                  class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-emerald-500" 
                />
              </div>
              <div>
                <label class="block text-[10px] font-bold text-stone-600 uppercase mb-1">Allergies / Notes</label>
                <input id="auth-allergies" type="text" placeholder="e.g. Ginger sensitive" class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-emerald-500" />
              </div>
            </div>

            <div>
              <label class="block text-[10px] font-bold text-stone-600 uppercase mb-1">Default Delivery Address *</label>
              <textarea id="auth-address" rows="2" placeholder="e.g. East Legon, near ANC Mall..." class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-emerald-500 resize-none"></textarea>
            </div>

            <div>
              <div class="flex items-center justify-between mb-1">
                <label class="block text-[10px] font-bold text-stone-600 uppercase">Google Maps Pin Link</label>
                <button type="button" id="auth-geo-btn" class="text-[10px] font-bold text-emerald-700 hover:underline">
                  📍 Use GPS Location
                </button>
              </div>
              <input id="auth-pin" type="url" placeholder="https://maps.google.com/?q=..." class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-emerald-500" />
            </div>
          </div>

          <!-- Standard Auth Fields -->
          <div>
            <label class="block text-[10px] font-bold text-stone-600 uppercase mb-1">Email Address</label>
            <input id="auth-email" type="email" required placeholder="kofi@gmail.com" class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-emerald-500" />
          </div>

          <div>
            <label class="block text-[10px] font-bold text-stone-600 uppercase mb-1">Password</label>
            <input id="auth-password" type="password" required placeholder="••••••••" class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold text-stone-900 focus:outline-none focus:border-emerald-500" />
          </div>

          <button type="submit" id="auth-submit-btn" class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-black rounded-2xl text-xs transition-all shadow-md shadow-emerald-600/20">
            Sign In
          </button>
        </form>

        <p id="auth-error" class="text-xs text-rose-600 text-center font-bold min-h-[1rem]"></p>

      </div>

    </div>
  </div>

  <script>
    import { auth, googleProvider, db } from '../lib/firebase';
    import { 
      signInWithEmailAndPassword, 
      createUserWithEmailAndPassword, 
      signInWithPopup, 
      onAuthStateChanged 
    } from 'firebase/auth';
    import { doc, getDoc, setDoc, serverTimestamp } from 'firebase/firestore';

    let isSignUpMode = false;

    const titleEl = document.getElementById('auth-title')!;
    const subtitleEl = document.getElementById('auth-subtitle')!;
    const submitBtn = document.getElementById('auth-submit-btn')!;
    const errorEl = document.getElementById('auth-error')!;
    const extraFields = document.getElementById('signup-extra-fields')!;
    const tabSignIn = document.getElementById('tab-signin')!;
    const tabSignUp = document.getElementById('tab-signup')!;
    const authGeoBtn = document.getElementById('auth-geo-btn');
    const authPinInput = document.getElementById('auth-pin') as HTMLInputElement;

    // Redirect if already logged in
    onAuthStateChanged(auth, (user) => {
      if (user) {
        window.location.href = '/dashboard';
      }
    });

    // Unified Mode Switcher Function
    function setAuthMode(signUp: boolean) {
      isSignUpMode = signUp;
      errorEl.textContent = '';

      const nameInput = document.getElementById('auth-name') as HTMLInputElement;
      const phoneInput = document.getElementById('auth-phone') as HTMLInputElement;
      const addressInput = document.getElementById('auth-address') as HTMLTextAreaElement;

      if (isSignUpMode) {
        tabSignUp.className = "py-2.5 rounded-xl text-xs font-black transition-all bg-white text-stone-950 shadow-xs";
        tabSignIn.className = "py-2.5 rounded-xl text-xs font-black transition-all text-stone-500 hover:text-stone-900";
        
        titleEl.textContent = 'Create Account';
        subtitleEl.textContent = 'Set up your profile once for instant 1-click juice ordering.';
        submitBtn.textContent = 'Create Account';
        extraFields.classList.remove('hidden');

        nameInput.required = true;
        phoneInput.required = true;
        addressInput.required = true;
      } else {
        tabSignIn.className = "py-2.5 rounded-xl text-xs font-black transition-all bg-white text-stone-950 shadow-xs";
        tabSignUp.className = "py-2.5 rounded-xl text-xs font-black transition-all text-stone-500 hover:text-stone-900";
        
        titleEl.textContent = 'Welcome Back';
        subtitleEl.textContent = 'Sign in to track orders and re-order in seconds.';
        submitBtn.textContent = 'Sign In';
        extraFields.classList.add('hidden');

        nameInput.required = false;
        phoneInput.required = false;
        addressInput.required = false;
      }
    }

    tabSignIn.addEventListener('click', () => setAuthMode(false));
    tabSignUp.addEventListener('click', () => setAuthMode(true));

    // Geolocation Pin Helper for Signup
    if (authGeoBtn && authPinInput) {
      authGeoBtn.addEventListener('click', () => {
        if (!navigator.geolocation) {
          alert('Geolocation is not supported by your browser.');
          return;
        }
        authGeoBtn.textContent = '⌛ Getting GPS...';
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const lat = pos.coords.latitude.toFixed(6);
            const lng = pos.coords.longitude.toFixed(6);
            authPinInput.value = `https://www.google.com/maps?q=${lat},${lng}`;
            authGeoBtn.textContent = '✓ Pin Attached!';
          },
          (err) => {
            alert('Could not get GPS location. Please paste your Google Maps link manually.');
            authGeoBtn.textContent = '📍 Use GPS Location';
          },
          { enableHighAccuracy: true }
        );
      });
    }

    // Handle Google Auth (Saves or merges profile preferences)
    document.getElementById('google-auth-btn')?.addEventListener('click', async () => {
      try {
        errorEl.textContent = '';
        const res = await signInWithPopup(auth, googleProvider);
        const user = res.user;

        const userRef = doc(db, 'users', user.uid);
        const snap = await getDoc(userRef);
        
        // Seed initial profile document if it doesn't exist
        if (!snap.exists()) {
          await setDoc(userRef, {
            email: user.email || '',
            name: user.displayName || '',
            phone: '',
            address: '',
            locationPin: '',
            allergies: '',
            createdAt: serverTimestamp(),
            updatedAt: new Date().toISOString()
          }, { merge: true });
        }
        window.location.href = '/dashboard';
      } catch (err: any) {
        errorEl.textContent = err.message || 'Google sign-in failed.';
      }
    });

    // Form Submit Handler (Supports both Sign In and Sign Up)
    document.getElementById('auth-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.textContent = '';

      const email = (document.getElementById('auth-email') as HTMLInputElement).value.trim();
      const password = (document.getElementById('auth-password') as HTMLInputElement).value;
      

      try {
        if (isSignUpMode) {
          const name = (document.getElementById('auth-name') as HTMLInputElement).value.trim();
          const phoneInput = document.getElementById('auth-phone') as HTMLInputElement;
          const phone = phoneInput.value.replace(/\D/g, ''); // strip any non-digit chars

          if (isSignUpMode) {
            if (phone.length !== 10) {
              errorEl.textContent = 'Phone number must be exactly 10 digits (e.g. 0241234567).';
              return;
            }
          }
          const address = (document.getElementById('auth-address') as HTMLTextAreaElement).value.trim();
          const locationPin = (document.getElementById('auth-pin') as HTMLInputElement).value.trim();
          const allergies = (document.getElementById('auth-allergies') as HTMLInputElement).value.trim();

          const userCred = await createUserWithEmailAndPassword(auth, email, password);
          
          // Use { merge: true } to guarantee all fields write safely into Firestore
          await setDoc(doc(db, 'users', userCred.user.uid), {
            email: email,
            name: name,
            phone: phone,
            address: address,
            locationPin: locationPin,
            allergies: allergies,
            createdAt: serverTimestamp(),
            updatedAt: new Date().toISOString()
          }, { merge: true });
        } else {
          await signInWithEmailAndPassword(auth, email, password);
        }
        window.location.href = '/dashboard';
      } catch (err: any) {
        if (err.code === 'auth/invalid-credential' || err.code === 'auth/user-not-found' || err.code === 'auth/wrong-password') {
          errorEl.textContent = 'Invalid email or password.';
        } else if (err.code === 'auth/email-already-in-use') {
          errorEl.textContent = 'An account already exists with this email.';
        } else {
          errorEl.textContent = err.message || 'Authentication error.';
        }
      }
    });
  </script>
</MainLayout>