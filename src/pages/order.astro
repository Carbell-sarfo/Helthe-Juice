---
// src/pages/order.astro
export const prerender = false;

import MainLayout from "../layouts/MainLayout.astro";
import { Image } from 'astro:assets';

// Import full flavor images
import mango from '../assets/products/mango.png';
import pineappleMango from '../assets/products/pineapple-mango.png';
import watermelonRed from '../assets/products/watermelon-red.png';
import watermelonOrange from '../assets/products/watermelon-orange.png';
import watermelonYellow from '../assets/products/watermelon-yellow.png';
import watermelonBeetroot from '../assets/products/watermelon-beetroot.png';
import watermelonMango from '../assets/products/watermelon-mango.png';
import appleBeetrootCarrot from '../assets/products/apple-beetroot-carrot.png';
import cucumberAppleKale from '../assets/products/cucumber-apple-kale.png';
import cucumberAppleSpinach from '../assets/products/cucumber-apple-spinach.png';
import cucumberBittermelon from '../assets/products/cucumber-bittermelon.png';
import pineapple from '../assets/products/pineapple.png';
import pineappleCucumberSpinach from '../assets/products/pineapple-cucumber-spinach.png';
import pineappleCarrot from '../assets/products/pineapple-carrot.png';
import pineappleCucumberMint from '../assets/products/pineapple-cucumber-mint.png';
import pineappleDandelion   from '../assets/products/pineapple-dandelion.png';
import pineappleGinger from '../assets/products/pineapple-ginger.png';
import pineappleMoringaGinger from '../assets/products/pineapple-moringa-ginger.png';
import pineappleSpinachGinger from '../assets/products/pineapple-spinach-ginger.png';
import pineapplePassionfruit from '../assets/products/pineapple-passionfruit.png';
import pineappleBeetroot from '../assets/products/pineapple-beetroot.png';
import orange from '../assets/products/orange.png';
import orangeCarrot from '../assets/products/orange-carrot.png';
import orangeBitterleafGinger from '../assets/products/orange-bitterleaf-ginger.png';

const juices = [
  { id: 'mango', name: 'Mango', fruits: ['mango'], image: mango },
  { id: 'pineapple-mango', name: 'Pineapple Mango', fruits: ['mango', 'pineapple'], image: pineappleMango },
  { id: 'watermelon-red', name: 'Red Watermelon', fruits: ['watermelon'], image: watermelonRed },
  { id: 'watermelon-yellow', name: 'Yellow Watermelon', fruits: ['watermelon'], image: watermelonYellow },
  { id: 'watermelon-orange', name: 'Orange Watermelon', fruits: ['watermelon'], image: watermelonOrange },
  { id: 'watermelon-beetroot', name: 'Beetroot Watermelon', fruits: ['watermelon', 'beetroot'], image: watermelonBeetroot },
  { id: 'watermelon-mango', name: 'Mango Watermelon', fruits: ['watermelon', 'mango'], image: watermelonMango },
  { id: 'apple-beetroot-carrot', name: 'Apple Beetroot Carrot', fruits: ['apple', 'beetroot', 'carrot'], image: appleBeetrootCarrot },
  { id: 'pineapple', name: 'Pineapple', fruits: ['pineapple'], image: pineapple },
  { id: 'pineapple-carrot', name: 'Pineapple Carrot', fruits: ['pineapple', 'carrot'], image: pineappleCarrot },
  { id: 'pineapple-spinach-ginger', name: 'Pineapple Spinach Ginger', fruits: ['pineapple', 'spinach', 'ginger'], image: pineappleSpinachGinger },
  { id: 'pineapple-cucumber-spinach', name: 'Pineapple Cucumber Spinach', fruits: ['pineapple', 'cucumber', 'spinach'], image: pineappleCucumberSpinach },
  { id: 'pineapple-passionfruit', name: 'Pineapple Passionfruit', fruits: ['pineapple', 'passionfruit'], image: pineapplePassionfruit },
  { id: 'pineapple-moringa-ginger', name: 'Pineapple Moringa Ginger', fruits: ['pineapple', 'moringa', 'ginger'], image: pineappleMoringaGinger },
  { id: 'pineapple-ginger', name: 'Pineapple Ginger', fruits: ['pineapple', 'ginger'], image: pineappleGinger },
  { id: 'pineapple-dandelion', name: 'Pineapple Dandelion', fruits: ['pineapple', 'dandelion'], image: pineappleDandelion },
  { id: 'pineapple-cucumber-mint', name: 'Pineapple Cucumber Mint', fruits: ['pineapple', 'cucumber', 'mint'], image: pineappleCucumberMint },
  { id: 'pineapple-beetroot', name: 'Pineapple Beetroot', fruits: ['pineapple', 'beetroot'], image: pineappleBeetroot },
  { id: 'cucumber-bittermelon', name: 'Cucumber Bittermelon', fruits: ['cucumber', 'bittermelon'], image: cucumberBittermelon },
  { id: 'orange', name: 'Orange', fruits: ['orange'], image: orange },
  { id: 'orange-carrot', name: 'Orange Carrot', fruits: ['orange', 'carrot'], image: orangeCarrot },
  { id: 'orange-bitterleaf-ginger', name: 'Orange Bitter-leaf Ginger', fruits: ['orange', 'bitter-leaf', 'ginger'], image: orangeBitterleafGinger },
  { id: 'cucumber-apple-kale', name: 'Cucumber Apple Kale', fruits: ['cucumber', 'apple', 'kale'], image: cucumberAppleKale },
  { id: 'cucumber-apple-spinach', name: 'Cucumber Apple Spinach', fruits: ['cucumber', 'apple', 'spinach'], image: cucumberAppleSpinach },
];

const allFruits = Array.from(new Set(juices.flatMap(j => j.fruits)));
---

<MainLayout title="Build Your Juice Box — Helthe Juice">
  <div class="min-h-screen bg-stone-50 py-10 px-3 sm:px-6 pt-32 pb-56 font-sans">
    <div class="max-w-6xl mx-auto space-y-8">
      
      <!-- Main Box Builder Container -->
      <div class="bg-white rounded-3xl border border-stone-200 shadow-xl p-4 sm:p-10 space-y-8">
        
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-stone-100 pb-6">
          <div class="space-y-1">
            <h1 class="text-2xl font-black text-stone-950 tracking-tight">Build Your Juice Box</h1>
            <p class="text-xs text-stone-500 font-medium">Select your bundle size and mix fresh cold-pressed blends in economic production batches.</p>
          </div>
          <div class="bg-emerald-50 border border-emerald-200 px-4 py-2 rounded-2xl flex items-center gap-3 self-start sm:self-auto">
            <span class="text-xs font-black text-emerald-800 uppercase tracking-wider">Allocated:</span>
            <span class="text-sm font-black text-emerald-950"><strong id="allocated-count">0</strong> / <span id="target-size">6</span> Btls</span>
          </div>
        </div>

        <!-- 1. CHOOSE BUNDLE SIZE -->
        <div class="space-y-3">
          <label class="block text-[11px] font-black text-stone-700 uppercase tracking-wider">1. Choose Bundle Size</label>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <button type="button" class="bundle-size-btn border-2 rounded-2xl p-4 text-center transition-all border-emerald-600 bg-emerald-50/40 cursor-pointer" data-size="6" data-price="240" data-step="3" data-maxflavors="2">
              <span class="block font-black text-base text-stone-950">6 Pcs</span>
              <span class="block font-[10px] text-emerald-800 font-bold mt-0.5">GHS 240</span>
              <span class="block text-[9px] text-stone-500 font-semibold">Max 2 flavors (±3)</span>
            </button>
            <button type="button" class="bundle-size-btn border-2 rounded-2xl p-4 text-center transition-all border-stone-200 bg-stone-50/50 hover:border-stone-300 cursor-pointer" data-size="15" data-price="525" data-step="5" data-maxflavors="3">
              <span class="block font-black text-base text-stone-950">15 Pcs</span>
              <span class="block font-[10px] text-emerald-800 font-bold mt-0.5">GHS 525</span>
              <span class="block text-[9px] text-stone-500 font-semibold">Max 3 flavors (±5)</span>
            </button>
            <button type="button" class="bundle-size-btn border-2 rounded-2xl p-4 text-center transition-all border-stone-200 bg-stone-50/50 hover:border-stone-300 cursor-pointer" data-size="20" data-price="700" data-step="5" data-maxflavors="4">
              <span class="block font-black text-base text-stone-950">20 Pcs</span>
              <span class="block font-[10px] text-emerald-800 font-bold mt-0.5">GHS 700</span>
              <span class="block text-[9px] text-stone-500 font-semibold">Max 4 flavors (±5)</span>
            </button>
            <button type="button" class="bundle-size-btn border-2 rounded-2xl p-4 text-center transition-all border-stone-200 bg-stone-50/50 hover:border-stone-300 cursor-pointer" data-size="30" data-price="1050" data-step="5" data-maxflavors="5">
              <span class="block font-black text-base text-stone-950">30 Pcs</span>
              <span class="block font-[10px] text-emerald-800 font-bold mt-0.5">GHS 1050</span>
              <span class="block text-[9px] text-stone-500 font-semibold">Max 5 flavors (±5)</span>
            </button>
          </div>
        </div>

        <!-- 2. MIX FLAVORS & FILTERS -->
        <div class="space-y-4 pt-4 border-t border-stone-100">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <label class="block text-[11px] font-black text-stone-700 uppercase tracking-wider">2. Choose Your Blends & Quantities</label>
            <div class="bg-stone-100 border border-stone-200 rounded-xl px-3 py-1.5 text-xs font-bold text-stone-700 flex items-center gap-2 self-start sm:self-auto">
              <span>Variety used: <strong id="flavors-used-count" class="text-stone-950">0</strong> / <span id="max-flavors-allowed">2</span> max</span>
              <span id="flavor-limit-warning" class="text-[10px] text-orange-600 font-extrabold hidden">• Limit reached</span>
            </div>
          </div>

          <!-- Search & Fruit Filter Bar -->
          <div class="space-y-2.5">
            <input 
              type="text" 
              id="boxSearchInput" 
              placeholder="Search by juice name (e.g., Pineapple Ginger, Beetroot)..." 
              class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold focus:outline-none focus:border-emerald-500"
            />
            <div class="flex flex-wrap gap-1.5 pt-1">
              {allFruits.map(fruit => (
                <button type="button" class="box-fruit-filter px-3 py-1 rounded-xl text-[10px] font-bold bg-stone-100 text-stone-600 hover:bg-stone-200 transition-all cursor-pointer" data-fruit={fruit}>
                  {fruit}
                </button>
              ))}
            </div>
          </div>

          <!-- PRODUCT CARD GRID: 2-Column on Mobile, 3/4-Column on Desktop with Unclipped Natural Images -->
          <div id="box-flavor-list" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-5 pt-2">
            {juices.map(juice => (
              <div 
                class="flavor-card bg-stone-50/70 border border-stone-200/80 rounded-3xl p-3 sm:p-4 flex flex-col justify-between gap-3 transition-all hover:shadow-md"
                data-name={juice.name.toLowerCase()}
                data-fruits={JSON.stringify(juice.fruits)}
              >
                <!-- Juice Image Container (Unclipped Natural View) -->
                <div class="space-y-2.5">
                  <div class="w-full aspect-[4/5] rounded-2xl bg-white border border-stone-200/80 overflow-hidden relative flex items-center justify-center p-3 shadow-xs">
                    <span class="absolute top-2 left-2 bg-stone-950/70 backdrop-blur-xs text-white text-[9px] font-black px-2 py-0.5 rounded-lg z-10">350ml</span>
                    <Image src={juice.image} alt={juice.name} width={300} height={400} class="w-full h-full object-contain object-center rounded-xl transition-transform duration-300 hover:scale-105" />
                  </div>
                  <div>
                    <h3 class="font-black text-xs sm:text-sm text-stone-950 line-clamp-1">{juice.name}</h3>
                    <div class="flex flex-wrap gap-1 mt-1">
                      {juice.fruits.map(f => <span class="text-[8px] bg-emerald-100/80 text-emerald-900 px-1.5 py-0.5 rounded font-bold uppercase tracking-wider">{f}</span>)}
                    </div>
                  </div>
                </div>

                <!-- Stepper Controls -->
                <div class="bg-white border border-stone-200 rounded-2xl p-1.5 sm:p-2 flex items-center justify-between shadow-xs">
                  <span class="text-[9px] font-black uppercase text-stone-400 pl-1 hidden sm:inline">Qty</span>
                  <div class="flex items-center gap-1.5 w-full justify-between sm:w-auto">
                    <button type="button" class="qty-sub w-8 h-8 rounded-xl bg-stone-100 border border-stone-200 text-stone-800 font-black text-xs hover:bg-stone-200 transition-all cursor-pointer flex items-center justify-center">-</button>
                    <input 
                      type="number" 
                      value="0" 
                      readonly
                      data-flavor={juice.name} 
                      class="box-qty-input w-8 text-center bg-transparent text-xs font-black text-stone-950 focus:outline-none" 
                    />
                    <button type="button" class="qty-add w-8 h-8 rounded-xl bg-emerald-600 text-white font-black text-xs hover:bg-emerald-700 transition-all cursor-pointer flex items-center justify-center shadow-xs">+</button>
                  </div>
                </div>
              </div>
            ))}
          </div>

        </div>

      </div>

    </div>
  </div>

  <!-- STICKY BOTTOM SUMMARY DRAWER WITH LIVE ITEMIZED BREAKDOWN -->
  <div id="sticky-checkout-bar" class="fixed bottom-0 left-0 right-0 bg-white/95 backdrop-blur-md border-t border-stone-200 shadow-2xl p-4 sm:p-6 z-40 transition-all transform translate-y-full">
    <div class="max-w-6xl mx-auto space-y-3">
      
      <!-- Live Itemized Breakdown (Shows selected juices so you know what's in your box!) -->
      <div id="sticky-items-preview" class="flex items-center gap-2 overflow-x-auto pb-1 text-xs font-bold text-stone-700 no-scrollbar">
        <span class="text-stone-400 italic text-[11px]">No juices selected yet.</span>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-stone-100 pt-3">
        <div class="flex items-center gap-6 w-full sm:w-auto">
          <div>
            <span class="text-[10px] font-black text-stone-400 uppercase tracking-wider block">Selected Box</span>
            <span id="drawer-box-title" class="text-sm font-black text-stone-950">6-Piece Bundle</span>
          </div>
          <div class="h-8 w-px bg-stone-200 hidden sm:block"></div>
          <div>
            <span class="text-[10px] font-black text-stone-400 uppercase tracking-wider block">Total Price</span>
            <span id="drawer-total-price" class="text-lg font-black text-emerald-800">GHS 240.00</span>
          </div>
          <div class="hidden md:block">
            <span id="drawer-status-text" class="text-xs font-bold text-orange-600 bg-orange-50 px-3 py-1 rounded-full border border-orange-200">
              Add 6 more bottles to complete box
            </span>
          </div>
        </div>

        <button 
          type="button" 
          id="proceed-to-checkout-btn" 
          disabled
          class="w-full sm:w-auto px-8 py-4 bg-emerald-600 hover:bg-emerald-700 disabled:bg-stone-300 disabled:cursor-not-allowed text-white font-black rounded-2xl text-xs transition-all shadow-lg shadow-emerald-600/30 cursor-pointer flex items-center justify-center gap-2"
        >
          <span>Proceed to Secure Checkout →</span>
        </button>
      </div>

    </div>
  </div>

  <!-- Box Builder Script -->
  <script>
    let targetSize = 6;
    let stepSize = 3;
    let maxFlavorsAllowed = 2;
    let currentBoxPrice = 240;

    const sizeBtns = document.querySelectorAll('.bundle-size-btn');
    const qtyInputs = document.querySelectorAll('.box-qty-input') as NodeListOf<HTMLInputElement>;
    const allocatedCountEl = document.getElementById('allocated-count')!;
    const targetSizeEl = document.getElementById('target-size')!;
    const flavorsUsedCountEl = document.getElementById('flavors-used-count')!;
    const maxFlavorsAllowedEl = document.getElementById('max-flavors-allowed')!;
    const flavorLimitWarning = document.getElementById('flavor-limit-warning')!;
    const stickyBar = document.getElementById('sticky-checkout-bar')!;
    const drawerBoxTitle = document.getElementById('drawer-box-title')!;
    const drawerTotalPrice = document.getElementById('drawer-total-price')!;
    const drawerStatusText = document.getElementById('drawer-status-text')!;
    const stickyItemsPreview = document.getElementById('sticky-items-preview')!;
    const proceedBtn = document.getElementById('proceed-to-checkout-btn') as HTMLButtonElement;

    sizeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        sizeBtns.forEach(b => {
          b.classList.remove('border-emerald-600', 'bg-emerald-50/40');
          b.classList.add('border-stone-200', 'bg-stone-50/50');
        });
        btn.classList.add('border-emerald-600', 'bg-emerald-50/40');
        btn.classList.remove('border-stone-200', 'bg-stone-50/50');

        targetSize = parseInt(btn.getAttribute('data-size') || '6');
        stepSize = parseInt(btn.getAttribute('data-step') || '3');
        maxFlavorsAllowed = parseInt(btn.getAttribute('data-maxflavors') || '2');
        currentBoxPrice = parseFloat(btn.getAttribute('data-price') || '240');

        targetSizeEl.textContent = String(targetSize);
        maxFlavorsAllowedEl.textContent = String(maxFlavorsAllowed);
        drawerBoxTitle.textContent = `${targetSize}-Piece Bundle`;
        drawerTotalPrice.textContent = `GHS ${currentBoxPrice.toFixed(2)}`;

        qtyInputs.forEach(i => i.value = '0');
        updateBoxState();
      });
    });

    qtyInputs.forEach(input => {
      const card = input.closest('.flavor-card')!;
      const subBtn = card.querySelector('.qty-sub')!;
      const addBtn = card.querySelector('.qty-add')!;

      subBtn.addEventListener('click', () => {
        let val = parseInt(input.value) || 0;
        if (val >= stepSize) {
          input.value = String(val - stepSize);
          updateBoxState();
        }
      });

      addBtn.addEventListener('click', () => {
        const currentTotal = getCurrentAllocatedTotal();
        if (currentTotal + stepSize > targetSize) {
          alert(`Adding ${stepSize} bottles exceeds your ${targetSize}-piece box limit!`);
          return;
        }

        const currentVal = parseInt(input.value) || 0;
        const usedFlavors = getUsedFlavorsCount();

        if (currentVal === 0 && usedFlavors >= maxFlavorsAllowed) {
          alert(`Maximum flavor variety limit reached (${maxFlavorsAllowed} flavors for this box). Increase quantity on existing flavors.`);
          return;
        }

        input.value = String(currentVal + stepSize);
        updateBoxState();
      });
    });

    function getCurrentAllocatedTotal() {
      let total = 0;
      qtyInputs.forEach(i => total += parseInt(i.value) || 0);
      return total;
    }

    function getUsedFlavorsCount() {
      let count = 0;
      qtyInputs.forEach(i => {
        if ((parseInt(i.value) || 0) > 0) count++;
      });
      return count;
    }

    function updateBoxState() {
      const allocated = getCurrentAllocatedTotal();
      const flavorsUsed = getUsedFlavorsCount();

      allocatedCountEl.textContent = String(allocated);
      flavorsUsedCountEl.textContent = String(flavorsUsed);

      if (flavorsUsed >= maxFlavorsAllowed) {
        flavorLimitWarning.classList.remove('hidden');
      } else {
        flavorLimitWarning.classList.add('hidden');
      }

      // Build live itemized preview pills
      let previewHTML = '';
      qtyInputs.forEach(input => {
        const qty = parseInt(input.value) || 0;
        if (qty > 0) {
          const name = input.getAttribute('data-flavor') || '';
          previewHTML += `<span class="bg-emerald-50 border border-emerald-200 text-emerald-900 px-2.5 py-1 rounded-xl text-[11px] font-black whitespace-nowrap flex items-center gap-1">
            ${qty}× ${name}
          </span>`;
        }
      });

      if (previewHTML === '') {
        stickyItemsPreview.innerHTML = `<span class="text-stone-400 italic text-[11px]">No juices selected yet. Pick your blends above!</span>`;
      } else {
        stickyItemsPreview.innerHTML = previewHTML;
      }

      if (allocated > 0) {
        stickyBar.classList.remove('translate-y-full');
      } else {
        stickyBar.classList.add('translate-y-full');
      }

      if (allocated === targetSize && flavorsUsed <= maxFlavorsAllowed) {
        proceedBtn.disabled = false;
        drawerStatusText.textContent = 'Box complete & ready!';
        drawerStatusText.className = 'text-xs font-black text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200';
      } else {
        proceedBtn.disabled = true;
        const diff = targetSize - allocated;
        if (diff > 0) {
          drawerStatusText.textContent = `Add ${diff} more bottles to complete box`;
        } else {
          drawerStatusText.textContent = `Too many bottles! Remove ${Math.abs(diff)}`;
        }
        drawerStatusText.className = 'text-xs font-bold text-orange-600 bg-orange-50 px-3 py-1 rounded-full border border-orange-200';
      }
    }

    proceedBtn.addEventListener('click', () => {
      const selectedItems: Array<{ name: string; qty: number }> = [];
      qtyInputs.forEach(input => {
        const qty = parseInt(input.value) || 0;
        if (qty > 0) {
          selectedItems.push({
            name: input.getAttribute('data-flavor') || 'Juice',
            qty: qty
          });
        }
      });

      const boxConfig = {
        boxSize: targetSize,
        totalPrice: currentBoxPrice,
        items: selectedItems
      };

      sessionStorage.setItem('helthe_box_config', JSON.stringify(boxConfig));
      window.location.href = '/checkout';
    });

    const searchInput = document.getElementById('boxSearchInput') as HTMLInputElement;
    const fruitFilterBtns = document.querySelectorAll('.box-fruit-filter');
    const flavorCards = document.querySelectorAll('.flavor-card') as NodeListOf<HTMLElement>;
    let activeFruitFilter = '';

    if (searchInput) {
      searchInput.addEventListener('input', () => applyFilters());
    }

    fruitFilterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const fruit = btn.getAttribute('data-fruit') || '';
        if (activeFruitFilter === fruit) {
          activeFruitFilter = '';
          btn.classList.remove('bg-emerald-600', 'text-white');
          btn.classList.add('bg-stone-100', 'text-stone-600');
        } else {
          activeFruitFilter = fruit;
          fruitFilterBtns.forEach(b => {
            b.classList.remove('bg-emerald-600', 'text-white');
            b.classList.add('bg-stone-100', 'text-stone-600');
          });
          btn.classList.remove('bg-stone-100', 'text-stone-600');
          btn.classList.add('bg-emerald-600', 'text-white');
        }
        applyFilters();
      });
    });

    function applyFilters() {
      const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

      flavorCards.forEach(card => {
        const name = card.getAttribute('data-name') || '';
        const fruitsAttr = card.getAttribute('data-fruits') || '[]';
        let fruits: string[] = [];
        try { fruits = JSON.parse(fruitsAttr); } catch (e) { fruits = []; }

        const matchesSearch = name.includes(query);
        const matchesFruit = activeFruitFilter === '' || fruits.includes(activeFruitFilter);

        if (matchesSearch && matchesFruit) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }
  </script>
</MainLayout>