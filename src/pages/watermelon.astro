---
// src/pages/watermelons.astro
import LandingPage from '../layouts/LandingPage.astro';
---

<LandingPage title="Exotic Watermelon Box Pre-Order | Helthe Juice">
  <main class="pb-52">
    
    <!-- Hero Header -->
    <header class="wm-header text-center mb-12">
        <div class="container">
            <div class="text-container">
                <span class="inline-block bg-amber-100 text-amber-800 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider mb-3">
                  Limited Box Drop 🍉
                </span>
                <h1 class="text-4xl sm:text-5xl font-extrabold text-blue-900 tracking-tight mb-4">
                  The Exotic Watermelon Box Pre-Order
                </h1>
                <p class="text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">
                  Secure your limited-batch Curated Mixed Box featuring <strong class="text-gray-900">15 vibrant, crisp watermelons for 525 GHS</strong>. Hand-harvested and delivered this <strong class="text-emerald-600">November</strong>. Two slots are already fully paid and locked in!</p>
            </div>
        </div>
    </header>

    <!-- Box Breakdown Grid -->
    <section class="mb-10 py-8">
        <div class="container">
            <h2 class="text-xs uppercase tracking-wider text-gray-400 font-bold mb-4 text-center">Inside Each 15piece Mixed Box (525 GHS)</h2>
            <div class="grid grid-cols-3 sm:grid-cols-3 gap-4">
              <div class="bg-red-50/50 border border-red-100 rounded-xl p-4 text-center">
                <span class="text-2xl">🔴</span>
                <h3 class="font-bold text-red-9ramble text-gray-900 mt-1">5 Red-Fleshed</h3>
                <p class="text-xs text-gray-500 mt-0.5">Classic, juicy refreshment</p>
              </div>
              <div class="bg-orange-50/50 border border-orange-100 rounded-xl p-4 text-center">
                <span class="text-2xl">🟠</span>
                <h3 class="font-bold text-orange-950 mt-1">5 Orange-Fleshed</h3>
                <p class="text-xs text-gray-500 mt-0.5">Rich, deep tropical notes</p>
              </div>
              <div class="bg-amber-50/50 border border-amber-100 rounded-xl p-4 text-center">
                <span class="text-2xl">🟡</span>
                <h3 class="font-bold text-amber-950 mt-1">5 Yellow-Fleshed</h3>
                <p class="text-xs text-gray-500 mt-0.5">Crisp, honey-like sweetness</p>
              </div>
            </div>
        </div>
    </section>

    <!-- Delivery Notice -->
    <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-5 text-center mb-10 shadow-sm flex flex-col sm:flex-row gap-4 items-center justify-between">
      <div class="text-left">
        <p class="text-xs uppercase tracking-wider text-emerald-700 font-bold mb-0.5">Estimated Timeline</p>
        <p class="text-base text-emerald-950 font-extrabold flex items-center gap-1.5">
          📦 Harvest & Delivery: November 2026
        </p>
      </div>
      <div class="text-right bg-emerald-600 text-white font-bold px-4 py-2 rounded-lg text-sm shadow-sm">
        Price: 525 GHS per Box
      </div>
    </div>

    <!-- Form Section -->
    <section class="bg-white border border-gray-100 rounded-2xl shadow-xl p-6 sm:p-10">
      <form id="waitlistForm" class="space-y-6">
        
        <!-- Row 1: Contact Info -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-sm font-semibold text-gray-700 mb-1">Your Name</label>
            <input type="text" id="name" name="name" required placeholder="e.g., Kwame Mensah" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition" />
          </div>
          <div>
            <label for="email" class="block text-sm font-semibold text-gray-700 mb-1">Email Address</label>
            <input type="email" id="email" name="email" required placeholder="name@example.com" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition" />
          </div>
        </div>

        <!-- Row 2: Phone & Quantity -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="phone" class="block text-sm font-semibold text-gray-700 mb-1">Phone Number (WhatsApp/Delivery)</label>
            <input type="tel" id="phone" name="phone" required placeholder="e.g., +233..." class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition" />
          </div>
          <div>
            <label for="quantity" class="block text-sm font-semibold text-gray-700 mb-1">Number of Boxes Requested</label>
            <input type="number" id="quantity" name="quantity" min="1" value="1" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition" />
          </div>
        </div>

        <!-- Selection Confirmation (Read Only visual reassurance) -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Selected Package</label>
          <div class="border border-emerald-200 bg-emerald-50/30 rounded-lg p-4 flex justify-between items-center">
            <div>
              <p class="text-sm font-bold text-gray-800">Curated Mixed Watermelon Box</p>
              <p class="text-xs text-gray-500">15 pieces total (5 Red, 5 Orange, 5 Yellow)</p>
            </div>
            <p class="text-sm font-extrabold text-emerald-700">525 GHS / box</p>
          </div>
        </div>

        <!-- CRM Additions: Allergies & Notes -->
        <div>
          <label for="allergies" class="block text-sm font-semibold text-gray-700 mb-1">Any dietary notes or allergies? <span class="text-gray-400 font-normal">(Optional)</span></label>
          <textarea id="allergies" name="allergies" rows="2" placeholder="e.g., Ginger allergy, diabetic-friendly preferences..." class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition"></textarea>
        </div>

        <!-- Payment Status Selection -->
        <div class="bg-gray-50 p-4 rounded-xl border border-gray-200">
          <label class="block text-sm font-semibold text-gray-800 mb-2">Reservation Payment Status</label>
          <div class="space-y-2">
            <label class="flex items-start cursor-pointer">
              <input type="radio" name="paymentStatus" value="Pay on Delivery" class="mt-1 text-emerald-600 focus:ring-emerald-500 h-4 w-4 mr-3" checked />
              <span class="text-sm text-gray-600">I want to reserve my box now and pay 525 GHS upon harvest/delivery.</span>
            </label>
            <label class="flex items-start cursor-pointer">
              <input type="radio" name="paymentStatus" value="Paid" class="mt-1 text-emerald-600 focus:ring-emerald-500 h-4 w-4 mr-3" />
              <span class="text-sm text-gray-600">I have already completed my Mobile Money transfer.</span>
            </label>
          </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-4 px-6 rounded-xl transition shadow-md hover:shadow-lg transform active:scale-[0.99]">
          Secure My Box Pre-Order 🚀
        </button>
      </form>
    </section>
  </main>
</LandingPage>





<style lang="scss">
    .wm-header {
        background-image: linear-gradient(to bottom, rgba(218, 194, 96, 0.2), rgba(255, 243, 196, 0.222)),url(../assets/watermelon-background.png);
        background-size: cover;
        background-position: center;
        min-height: 75vh;
        display: flex;
        flex-direction: row;
        align-items: center;

        .text-container {
            max-width: 600px;
            margin: 0 auto;
        }
    }
</style>